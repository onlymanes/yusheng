[
 {
  "text": "就爲你曾經使我擁有過生命",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "風裏吹不亂的是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "寧可讓我苦，不願讓你難過",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "爲你飛身撲滅那熊熊烈火",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "如今我才知道，它在我胸口跳動",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "走出空氣污染的地球",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "不求軒不求冕，不爲這紅塵所囚",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "但我要背向地球，希望寄託整個宇宙",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "看看我的笑容，是不是還保有自我",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "終日枯坐冥想裏，看盡了旁人看不清自己",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "我就要轉彎，我就要看到",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "讓我化成夢中的精靈",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "湖心草深長，我心無處藏",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "唱起這首尋常的歌，享受這種尋常的樂",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "所以我要現在這樣地活着",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "妹妹晚安，我很想念你",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "我想我不會放棄那些有你的記憶",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "哲學的答案都是幼稚的分析",
  "kind": "lyric",
  "source": "《青澀的記憶》/《一天到晚游泳的魚》"
 },
 {
  "text": "有過皆珍貴，生命堪玩味",
  "kind": "lyric",
  "source": "《無知的歲月》/《一天到晚游泳的魚》"
 },
 {
  "text": "生命的意義昇華爲對那萬物有情的瞭解明白",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的魚》"
 },
 {
  "text": "我不想受束縛只要自由自在",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "這是我們的自由",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "愛從不輕易地來，從不輕易走開",
  "kind": "lyric",
  "source": "《愛從不輕易地來》/《自由歌》"
 },
 {
  "text": "讓我告訴你雲朗天清的地方",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "灑下金黃色的愛，溫暖你我的胸懷",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "霎時靈光撥弄我心絃，甘美思緒如水瀉",
  "kind": "lyric",
  "source": "《靈光》/《卡拉OK·臺北·我》"
 },
 {
  "text": "好一陣山風，好一輪秋月",
  "kind": "lyric",
  "source": "《子夜紓懷》/《卡拉OK·臺北·我》"
 },
 {
  "text": "兄弟呀，我有多麼的愛你",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你給我安慰，我不至頹廢",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你寬容慈悲，我能振翅高飛",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "總是不能忘記那一種感覺",
  "kind": "lyric",
  "source": "《蝴蝶結》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我期待有一天我會回來",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "分合的無奈能換來春夜的天籟",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "昂首闊步，不留一絲遺憾",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "給我一把吉它我來唱",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "給我一對翅膀我來飛",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你跟得上我吧，你學得還好吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·臺北·我》"
 },
 {
  "text": "只剩這首動物的悲歌",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "沒你的日子，我習慣爲你留盞燈",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "但願你能是我的最終",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "即使再冷再寒的雨夜裏也有一盞小燈火",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "別放棄希望",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "星火燎原，我熱情的眼眸曾點亮最燦爛的天空",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "等一等這些傷會自由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "玫瑰多情也多刺，竟與你似曾相識",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "只要能夠陪着你我都願意",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "當你平躺下來，我便成了河",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "等到昏黃，等到癡傻，等着公主吻青蛙",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "如果你要離開我，我想我不會太難過",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "如果你要離開我，世界還是會向前走",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "只想讓每一分一秒都很美妙",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "若我告訴你其實我愛的只是你",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "一對指戒，一諾百年",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "當你的心已累，以爲失去了一切",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "其實等在前面還有一整個世界",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "快樂的天堂源自心田而非外在",
  "kind": "lyric",
  "source": "《我的愛》/《雨生歡禧城》"
 },
 {
  "text": "風留給春天，雲留給雨天",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "心留給世界，人留給歲月",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "背起行囊我要去遠方，遠得可以把過去遺忘",
  "kind": "lyric",
  "source": "《單身旅記》/《雨生歡禧城》"
 },
 {
  "text": "迎接明天，擦亮雪亮的尊嚴",
  "kind": "lyric",
  "source": "《哭泣與耳語》/《雨生歡禧城》"
 },
 {
  "text": "讓未知孵化我不渝的信仰",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "總要悠悠歲月還我本來容顏",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "凡已做過的事不消失，凡真愛過的情盡成癡",
  "kind": "lyric",
  "source": "《凡》/《如燕盤旋而來的思念》"
 },
 {
  "text": "總在凌晨四點，才能訴說最美麗的語言",
  "kind": "lyric",
  "source": "《如燕盤旋而來的思念》/《如燕盤旋而來的思念》"
 },
 {
  "text": "凡是走過，必定留下或深或淺的痕跡",
  "kind": "lyric",
  "source": "《還以爲》/《如燕盤旋而來的思念》"
 },
 {
  "text": "常常在星空下想你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "常常在晚風中說你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "把精巧日記本輕輕拿起",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "用小鎖打開琳琅滿目的回憶",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "纏綿的夢境裏有你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "憂鬱的只是我想你念你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "心裏裝滿相思不盡的失迷",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "偷偷在倩笑裏尋你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "深深在心版上寫你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "你愛在沙灘上對流星輕語",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "說這一生一世永成美麗印記",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "在愛的堅貞裏是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "爲心情流淚的是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "害怕會帶給你太多的愁悒",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "他們滿臉風霜，他們眼神迷茫",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們箕踞圍坐，他們孤獨蜷縮",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們蹣跚的步履踩過整個中國",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們交迭的皺紋是歷史的跡痕",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們黑光的脣齒舐過泥濘雨血",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們抖顫的雙手曾在炮火下穿梭",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "總在朝霞未升，他們就已起身",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "露珠不及親吻，大地已被汗水溼潤",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "穿着粗布的寬衣，走在縱橫的田梗",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "吐着濃濃的煙霧，恣任冥思出神",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "燦爛的陽光溫暖不到這樣的角落",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "一個慘被自私的文明遺忘的角落",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "每當我一眼瞥見他們，就感到心頭一陣隱痛",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "畢竟生命的歷練，不是旁人隨便就能夠體會",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們以前也念過詩書，也談過戀愛",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "也擁有天倫擁有工作，和自己的一片天空",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們今天有山上種樹，有廁所收錢",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "也有人賣面賣臭豆腐，和自己的風燭殘年",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "但當到我知道他是抗戰中的無名英雄",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "我一身罪愆，難是卑微良心所能撫慰",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "你心裏憂鬱你在哭泣",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 }
]
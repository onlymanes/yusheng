[
 {
  "text": "就为你曾经使我拥有过生命",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "风里吹不乱的是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "宁可让我苦，不愿让你难过",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "为你飞身扑灭那熊熊烈火",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "如今我才知道，它在我胸口跳动",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "走出空气污染的地球",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "不求轩不求冕，不为这红尘所囚",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "但我要背向地球，希望寄托整个宇宙",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "看看我的笑容，是不是还保有自我",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "终日枯坐冥想里，看尽了旁人看不清自己",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "我就要转弯，我就要看到",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "让我化成梦中的精灵",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "湖心草深长，我心无处藏",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "唱起这首寻常的歌，享受这种寻常的乐",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "所以我要现在这样地活着",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "妹妹晚安，我很想念你",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "我想我不会放弃那些有你的记忆",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "哲学的答案都是幼稚的分析",
  "kind": "lyric",
  "source": "《青涩的记忆》/《一天到晚游泳的鱼》"
 },
 {
  "text": "有过皆珍贵，生命堪玩味",
  "kind": "lyric",
  "source": "《无知的岁月》/《一天到晚游泳的鱼》"
 },
 {
  "text": "生命的意义升华为对那万物有情的了解明白",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的鱼》"
 },
 {
  "text": "我不想受束缚只要自由自在",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "这是我们的自由",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "爱从不轻易地来，从不轻易走开",
  "kind": "lyric",
  "source": "《爱从不轻易地来》/《自由歌》"
 },
 {
  "text": "让我告诉你云朗天清的地方",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "洒下金黄色的爱，温暖你我的胸怀",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "霎时灵光拨弄我心弦，甘美思绪如水泻",
  "kind": "lyric",
  "source": "《灵光》/《卡拉OK·台北·我》"
 },
 {
  "text": "好一阵山风，好一轮秋月",
  "kind": "lyric",
  "source": "《子夜纾怀》/《卡拉OK·台北·我》"
 },
 {
  "text": "兄弟呀，我有多么的爱你",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·台北·我》"
 },
 {
  "text": "你给我安慰，我不至颓废",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "你宽容慈悲，我能振翅高飞",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "总是不能忘记那一种感觉",
  "kind": "lyric",
  "source": "《蝴蝶结》/《卡拉OK·台北·我》"
 },
 {
  "text": "我期待有一天我会回来",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "分合的无奈能换来春夜的天籁",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "昂首阔步，不留一丝遗憾",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "给我一把吉它我来唱",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "给我一对翅膀我来飞",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "你跟得上我吧，你学得还好吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·台北·我》"
 },
 {
  "text": "只剩这首动物的悲歌",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "没你的日子，我习惯为你留盏灯",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "但愿你能是我的最终",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "即使再冷再寒的雨夜里也有一盏小灯火",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "别放弃希望",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "星火燎原，我热情的眼眸曾点亮最灿烂的天空",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "等一等这些伤会自由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "玫瑰多情也多刺，竟与你似曾相识",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "只要能够陪着你我都愿意",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "当你平躺下来，我便成了河",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "等到昏黄，等到痴傻，等着公主吻青蛙",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "如果你要离开我，我想我不会太难过",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "如果你要离开我，世界还是会向前走",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "只想让每一分一秒都很美妙",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "若我告诉你其实我爱的只是你",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "一对指戒，一诺百年",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "当你的心已累，以为失去了一切",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "其实等在前面还有一整个世界",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "快乐的天堂源自心田而非外在",
  "kind": "lyric",
  "source": "《我的爱》/《雨生欢禧城》"
 },
 {
  "text": "风留给春天，云留给雨天",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "心留给世界，人留给岁月",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "背起行囊我要去远方，远得可以把过去遗忘",
  "kind": "lyric",
  "source": "《单身旅记》/《雨生欢禧城》"
 },
 {
  "text": "迎接明天，擦亮雪亮的尊严",
  "kind": "lyric",
  "source": "《哭泣与耳语》/《雨生欢禧城》"
 },
 {
  "text": "让未知孵化我不渝的信仰",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "总要悠悠岁月还我本来容颜",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "凡已做过的事不消失，凡真爱过的情尽成痴",
  "kind": "lyric",
  "source": "《凡》/《如燕盘旋而来的思念》"
 },
 {
  "text": "总在凌晨四点，才能诉说最美丽的语言",
  "kind": "lyric",
  "source": "《如燕盘旋而来的思念》/《如燕盘旋而来的思念》"
 },
 {
  "text": "凡是走过，必定留下或深或浅的痕迹",
  "kind": "lyric",
  "source": "《还以为》/《如燕盘旋而来的思念》"
 },
 {
  "text": "常常在星空下想你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "常常在晚风中说你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "把精巧日记本轻轻拿起",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "用小锁打开琳琅满目的回忆",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "缠绵的梦境里有你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "忧郁的只是我想你念你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "心里装满相思不尽的失迷",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "偷偷在倩笑里寻你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "深深在心版上写你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "你爱在沙滩上对流星轻语",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "说这一生一世永成美丽印记",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "在爱的坚贞里是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "为心情流泪的是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "害怕会带给你太多的愁悒",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "他们满脸风霜，他们眼神迷茫",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们箕踞围坐，他们孤独蜷缩",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们蹒跚的步履踩过整个中国",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们交迭的皱纹是历史的迹痕",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们黑光的唇齿舐过泥泞雨血",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们抖颤的双手曾在炮火下穿梭",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "总在朝霞未升，他们就已起身",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "露珠不及亲吻，大地已被汗水湿润",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "穿着粗布的宽衣，走在纵横的田梗",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "吐着浓浓的烟雾，恣任冥思出神",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "灿烂的阳光温暖不到这样的角落",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "一个惨被自私的文明遗忘的角落",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "每当我一眼瞥见他们，就感到心头一阵隐痛",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "毕竟生命的历练，不是旁人随便就能够体会",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们以前也念过诗书，也谈过恋爱",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "也拥有天伦拥有工作，和自己的一片天空",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们今天有山上种树，有厕所收钱",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "也有人卖面卖臭豆腐，和自己的风烛残年",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "但当到我知道他是抗战中的无名英雄",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "我一身罪愆，难是卑微良心所能抚慰",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "你心里忧郁你在哭泣",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "我守在一边希望你能欢喜",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "你红肿眼睛告诉我关怀祈语",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "并不是此刻最需要的东西",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "你闭起眼睛暗示我浓情深意",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "并不能回答这进退不得的难题",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "我可以愁我可以痛",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "要你满腔心碎的泪不用再流",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "你怎么愁我怎么痛",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "要在一身风絮以后才能悟懂",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "这世界似乎没有恒久的情",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "让电话持续我不禁捏紧手心",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "想告诉你这一切会有个不差的结局",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "我没有走过父亲走过的长路",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "他的年少是几番沧桑几番血泪",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "我没有看过父亲看过的国土",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "他的乡愁是浩荡之江滚滚之水",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "我只能偷偷瞄着父亲的眼眸",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "感觉他眼光最深沉处的浮云苍狗",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "我没有留下父亲留下的疮疤",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "他的伤痕是不敢思忆不堪回首",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "我没有经历父亲经历的挣扎",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "他的割舍是午夜梦回茫然失落",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "我只有悄悄等着父亲的动容",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "感觉他神色最恍惚间的爱恨交错",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "什么叫中国我曾经没有把握",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "什么叫中国我现在真有把握",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "是父亲毕生的守候我与生俱来的光荣",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "走马观花日子里",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "从未留下深刻记忆",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "终究时间耗尽",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "才知皮相的生命",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "是要去深掘的古井",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "在生与死的边际",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "躲在等待的后面",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "我无知的手遮着岁月的容颜",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "手记分割了思维",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "是对未来无色预言",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "走出纷争喧扰的生活",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "因为漫天黑烟腐蚀掉我的梦",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "因为征战杀伐我就快要没有朋友",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "带我去月球那里空气稀薄",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "带我去月球充满原始坑洞",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "带我去月球重力轻浮你我",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "挣扎在一片荒漠也不见嫦娥相从",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "看我虚步玲珑蹑星空",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "我爱醉卧亭台作风流",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "只是狂歌一曲恍惚间就化入无穷",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "将进酒杯莫停",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "人生不过一场大梦",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "看看我的瞳孔还燃不燃烧焰火",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "下弦月上弦月就让我被月蚀吞没",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "这一夜我睡不着",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "随便弹一些旧曲调",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "这一夜我好心焦",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "你的身影在我眼前飘",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "不知道你好不好",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "美丽的脸有点憔悴与烦恼",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "我向窗外星空幽幽呼叫",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "我将知道你的不安的寻找",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "再变成你的温柔的微笑",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "转过那个弯就可以看到",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我不停地绊倒止不住的心焦",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "以为生命在那里会有成就的骄傲",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "转过那个弯就可以知道",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我收拾起执拗不再坚持思考",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "幻想生命在那里获得脱俗的清高",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "但我从来想象不到",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "那个弯的崎岖好比在我心中插满了刀",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我一路走一路拔",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我就要转弯我就要知道",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "却赫然踯躅脚步质疑那是怎么样的目标",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "真正的世界在那个弯道",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我摇头晃脑实在莫名其妙",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "可能生命在那里才有实现的必要",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "文明的社会在那个弯道",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我有一点苦恼我有一点混淆",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "希望生命在那里展示血热的激潮",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "但我从来意料不到",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "那个弯的颠踬好比在我耳旁凄厉的呼啸",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "我一路走一路遮",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "仍然对路旁的尸骨默念和平的晚祷",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "小小的年纪",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "猛打翻滚沾一身草青",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "昂首高歌谁说不神气",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "山菊兀自迎风摇曳",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "老牛眼神一阵调皮",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "窃笑着踩过未干水泥地的蹄印",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "有很多朋友都是些小人物却从来不烦忧",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "往海里丢泪水和懵懂",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "嬉戏雷雨过的午后",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "种种诙谐中的稚幼",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "模糊又熟悉多时的面孔",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "少年击剑更吹箫不爱财宝爱英豪",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "少年吟诗更风骚不羡人间羡唐朝",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "少年狂狷更急躁不知跋扈知炫耀",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "去日苦多的时候",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "青青子衿悠悠行吟过今昔",
  "kind": "lyric",
  "source": "《总发游》/《带我去月球》"
 },
 {
  "text": "守着春天的火焰",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "笑问天上的云霞",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "我该不该细细想她",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "疏星几点新月淡",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "路上没有夜行人",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "看我不喜也不悲",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "我想这样告诉她",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "不避夏日的酷热",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "骑车顶着艳阳天",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "我该不该轻轻问她",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "凡路总会有尽头",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "凡人总要有归向",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "你说台北从来不曾下过一场雪",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "我说我能明白季节常恒之理",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你何须太自贬",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你说台北真看不见无际的绿野",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "我说我能明白文明工斧之苦",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你不必太在意",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你猜台北将来可有自己的音乐",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "我看文化变迁不是一天两天",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你千万别心虚",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "终究台北会有一个特殊的空间",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "我看是好是坏还在未定之天",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "你千万别心急",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "有一阵的眩昏",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "我是追逐绿洲的旅人",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "深夜里等闪逝的星",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "我是守候火炬的猎人",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "什么急什么缓",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "什么不慌不乱",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "当我鼓足勇气冲向心底的终站",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "失去与获得会带来多少快乐",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "我对爱曾懂得几分",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "依稀有过浓稠的愁恨",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "我对人世曾懂得几分",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "也是吐过血性的激愤",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "什么深什么浅",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "什么纠结缠绵",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "当我披挂上阵用力嘶喊过来",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "胜利与失败会留下多少伤害",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "年少的时候，谁说没烦忧",
  "kind": "lyric",
  "source": "《青涩的记忆》/《一天到晚游泳的鱼》"
 },
 {
  "text": "不曾深爱过，不曾追求过",
  "kind": "lyric",
  "source": "《青涩的记忆》/《一天到晚游泳的鱼》"
 },
 {
  "text": "一伙臭朋友徜徉夕阳中",
  "kind": "lyric",
  "source": "《青涩的记忆》/《一天到晚游泳的鱼》"
 },
 {
  "text": "脱壳的蜕变竟需要生命历练",
  "kind": "lyric",
  "source": "《冰点》/《一天到晚游泳的鱼》"
 },
 {
  "text": "而一天天地成熟在许多痛苦尖锐的打击",
  "kind": "lyric",
  "source": "《冰点》/《一天到晚游泳的鱼》"
 },
 {
  "text": "爱谈天也爱白日梦",
  "kind": "lyric",
  "source": "《冰点》/《一天到晚游泳的鱼》"
 },
 {
  "text": "一伙臭朋友徜徉冰冷中",
  "kind": "lyric",
  "source": "《冰点》/《一天到晚游泳的鱼》"
 },
 {
  "text": "真怕你认不得我的改变",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "家里格局仍一样，只是少了你的床",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "寒夜里是否有人与你为伴",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "当风和日丽，阳春三月天",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的鱼》"
 },
 {
  "text": "缤纷的足迹，飞扬的笑靥",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的鱼》"
 },
 {
  "text": "一伙臭朋友徜徉诗意中",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的鱼》"
 },
 {
  "text": "风过树林，突然我们寻到默契",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的鱼》"
 },
 {
  "text": "天朗气清，仿佛前世我们已相遇",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的鱼》"
 },
 {
  "text": "就这么继续，让我们的心灵慢慢地累积那种情绪",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的鱼》"
 },
 {
  "text": "但凤凰花开后，却是一番离别",
  "kind": "lyric",
  "source": "《仲夏夜之梦》/《一天到晚游泳的鱼》"
 },
 {
  "text": "远离了童年，不能说没感觉",
  "kind": "lyric",
  "source": "《仲夏夜之梦》/《一天到晚游泳的鱼》"
 },
 {
  "text": "而人不能恋旧，我们又必须往前",
  "kind": "lyric",
  "source": "《仲夏夜之梦》/《一天到晚游泳的鱼》"
 },
 {
  "text": "我曾经恋爱过，我曾经忧愁过",
  "kind": "lyric",
  "source": "《无知的岁月》/《一天到晚游泳的鱼》"
 },
 {
  "text": "而一天天的沉浮在，过去未来复杂的联想",
  "kind": "lyric",
  "source": "《无知的岁月》/《一天到晚游泳的鱼》"
 },
 {
  "text": "不再问为什么，不挑剔已拥有",
  "kind": "lyric",
  "source": "《无知的岁月》/《一天到晚游泳的鱼》"
 },
 {
  "text": "让我握住你瘦骨嶙峋的小手",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "让我指引你触手可及的天堂",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "同你一样跳动，同你一样颤抖",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "形影不离天不怕地不怕",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "快乐的日子却并没有很长，万丈高楼大厦遮住金黄的阳光",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "直到那天他们找不到妈妈",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "小黑站在小花冰冷的身体旁",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "我珍藏的记忆，随风轻抚心灵",
  "kind": "lyric",
  "source": "《灵光》/《卡拉OK·台北·我》"
 },
 {
  "text": "罗网交织出优美侧面，撷取这大块的瞬间",
  "kind": "lyric",
  "source": "《灵光》/《卡拉OK·台北·我》"
 },
 {
  "text": "速写此刻给此心此身的温柔",
  "kind": "lyric",
  "source": "《灵光》/《卡拉OK·台北·我》"
 },
 {
  "text": "不可以世俗斗量的情感",
  "kind": "lyric",
  "source": "《永公街的街长》/《卡拉OK·台北·我》"
 },
 {
  "text": "永公街的街长，他是文明社会的罪与罚",
  "kind": "lyric",
  "source": "《永公街的街长》/《卡拉OK·台北·我》"
 },
 {
  "text": "永公街的街长，像只漂鸟因固执的追寻而跌下",
  "kind": "lyric",
  "source": "《永公街的街长》/《卡拉OK·台北·我》"
 },
 {
  "text": "好一个梦般子夜，细忖我们的是非",
  "kind": "lyric",
  "source": "《子夜纾怀》/《卡拉OK·台北·我》"
 },
 {
  "text": "野火般婆娑，天空般宽容",
  "kind": "lyric",
  "source": "《子夜纾怀》/《卡拉OK·台北·我》"
 },
 {
  "text": "狂热的自由，冰冷的静默",
  "kind": "lyric",
  "source": "《子夜纾怀》/《卡拉OK·台北·我》"
 },
 {
  "text": "因为失去要比拥有容易",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·台北·我》"
 },
 {
  "text": "我们背对背前行，朝着路的两端走去",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·台北·我》"
 },
 {
  "text": "年长以后谈笑起，那少不更事的意气",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·台北·我》"
 },
 {
  "text": "太阳烧红了海洋，海洋包容了太阳",
  "kind": "lyric",
  "source": "《这一年这一夜》/《卡拉OK·台北·我》"
 },
 {
  "text": "这一年这一夜，回忆温暖我疲惫",
  "kind": "lyric",
  "source": "《这一年这一夜》/《卡拉OK·台北·我》"
 },
 {
  "text": "看似清实迷离，情路又玄又是漩",
  "kind": "lyric",
  "source": "《这一年这一夜》/《卡拉OK·台北·我》"
 },
 {
  "text": "爱与恨痴与嗔，你不用再区分也不必再等",
  "kind": "lyric",
  "source": "《我的心在发烫》/《卡拉OK·台北·我》"
 },
 {
  "text": "天天想天天都一样，我用热情怀抱希望",
  "kind": "lyric",
  "source": "《我的心在发烫》/《卡拉OK·台北·我》"
 },
 {
  "text": "爱得慌，我无处可藏",
  "kind": "lyric",
  "source": "《我的心在发烫》/《卡拉OK·台北·我》"
 },
 {
  "text": "你披星戴月，你不辞冰雪",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "你像远在天边，又似近在眼前",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "你不告而别，我才后知后觉",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "烫金的滚边，墨绿的绒面",
  "kind": "lyric",
  "source": "《蝴蝶结》/《卡拉OK·台北·我》"
 },
 {
  "text": "终于还是回到玻璃橱窗前",
  "kind": "lyric",
  "source": "《蝴蝶结》/《卡拉OK·台北·我》"
 },
 {
  "text": "然而现在这个蝴蝶结，却静静躺在心灵的深渊",
  "kind": "lyric",
  "source": "《蝴蝶结》/《卡拉OK·台北·我》"
 },
 {
  "text": "就问我这些日子来是否心依旧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·台北·我》"
 },
 {
  "text": "我大半的时间里，都存在你左右",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·台北·我》"
 },
 {
  "text": "你跟得上我吧，你还习惯我吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·台北·我》"
 },
 {
  "text": "我情愿现在与未来，能充满秋凉的爽快",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "前前后后，迂迂回回地试探",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "我就是不能忘掉那盆兰花草",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "梵音在弦外，醉翁意韵妙",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "你只要给我五分钟，我给你完全不同的感受",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "我有一点无聊，我有一点寂寞",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "我闲了就工作，我累了就出游",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "政治是什么，民主怎么做",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "我从不轻易地爱，从不轻言要离开",
  "kind": "lyric",
  "source": "《爱从不轻易地来》/《自由歌》"
 },
 {
  "text": "晨曦的美就是一种爱",
  "kind": "lyric",
  "source": "《爱从不轻易地来》/《自由歌》"
 },
 {
  "text": "深蓝的星夜也是一种爱",
  "kind": "lyric",
  "source": "《爱从不轻易地来》/《自由歌》"
 },
 {
  "text": "你来的时候伴随山茶的清芬",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "日升月落风起云涌转眼空",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "当我想起红尘瞬变心底好难过",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "回到初相见那一天我们多腼腆",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "微笑似清水激荡起如诗的回旋",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "当爱在空中飘当雪从山巅融化掉",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "我守在记忆的窗口",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "坚持在浩瀚人生巨流里前航",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "回首的刹那请容许我猖狂",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "短促的美丽也深烙印生命",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "不同的岁月是不同的字句",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "过去我不羁的豪情在汗泪中前进",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "小陈风尘仆仆划破腊寒而来",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "她想走就让她走留来留去留成仇",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "求她的话我说不出口",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "她想做就该她做守到最后也没有用",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "感情在长久不在强求爱她就要任她悠游",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "异国的风雪是故乡的恋人没有办法遮掩呵护的世界",
  "kind": "lyric",
  "source": "《再见女郎》/《白色才情》"
 },
 {
  "text": "斜的横的都是画",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "胭脂沾惹双鬓生香",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "学飞蛾扑向火光",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "在眉宇之间啼吟她的羞娇",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "就扑拍翅膀奔向她的怀抱",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "此生愿为她囚进笼牢",
  "kind": "lyric",
  "source": "《后窗》/《白色才情》"
 },
 {
  "text": "一时之间我遗失了语言",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "谁不在等待他的贝德丽采",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "如果你柔情的双眼悬挂在天边",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "我也要散尽所有力气雄雄为你搏一回",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "你让我发晕发到了最高点",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "你让我从早到晚疯疯癫癫",
  "kind": "lyric",
  "source": "《发晕》/《白色才情》"
 },
 {
  "text": "只让阳光慢慢烫一夜寂寞的冰凉",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "总在灵魂深处藏了一些喜悲",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "喝了酒会有点醉爱人走了掉眼泪",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "但我挡不住潮水将沉默往我心里堆",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "却把重重怅惘枕在自己肩上",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "爱是空气也是瘟疫",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "也许有一点点难过至少不会在你的面前难过",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "就算我真的很心痛至少脸上还挂着一幅笑容",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "也许它慢慢改变我至少改变也不是坏的结果",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "如果你要离开请别到最后一刻才告诉我",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "口是心非你深情的承诺都随着西风飘渺远走",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "晴天霹雳你绝情的放手在我最需要你的时候",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "于是爱恨交错人消瘦",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "怕是怕这些苦没来由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "于是悲欢起落人静默",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "浑然天成我纯情的悸动曾奔放最滚烫的节奏",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "时间过得快爱得太奇怪",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "直到我们一再目送彼此消失于人海之外",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "我想我的愚昧都被你容在桶内",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "白净的纸让我若有所思若有所失若有所痴",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "有时候娇横伤人有时候娇柔依人",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我只能用最奢侈的玻璃为你筑起不惧风雨的天地",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我就是你忠实的园丁",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我像圣堂下为你禁欲的僧侣",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "即使你宁可自由自在呼吸那一窗星星",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "聚为一泓泉水深邃清澈",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "我是朝圣的人我是客途的雁却一往情深",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "从此无意追逐新绿的春",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "天曾缺掉的角无非此等神采",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "你正颔首告知这里有爱",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "最美丽的季节里我们初相遇",
  "kind": "lyric",
  "source": "《···的图案》/《口是心非》"
 },
 {
  "text": "就在至高的峰顶我们风化了爱情",
  "kind": "lyric",
  "source": "《···的图案》/《口是心非》"
 },
 {
  "text": "当我不慎任她下坠赤道也叠起了雪",
  "kind": "lyric",
  "source": "《···的图案》/《口是心非》"
 },
 {
  "text": "转开我发热的身体足足地球的半径",
  "kind": "lyric",
  "source": "《···的图案》/《口是心非》"
 },
 {
  "text": "我的心随你牵引随你欢喜而欢喜",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "随你爱随你恨随你一意孤行我都愿意",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "我的梦随你拥有随你哀愁而哀愁",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "随你痴随你怨随你漫天遨游我不退缩",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "你的温柔你的轮廓你的洒脱在我心底都是飘逸水墨",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "因为太难以形容只能对着自己说",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "神采我最爱躲在梦里喃喃念出来",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "你的言语你的欢声你的呼吸播放一种巴洛克的旋律",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "当月光歌颂着绝伦的天上诗篇",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "相思会醉爱恋能痴",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "在星辰造型出神圣的几何以前",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "所以你说你情愿迎接繁复的柴米油盐",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "你让我惊喜你的自信",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "你已不是你当你急于要改变自己",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "你就是你就是你独一不二的你",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "何不就把你淋漓尽致地秀出去",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "在午夜过后的风雨里不由自主的想着你",
  "kind": "lyric",
  "source": "《Only Once》/《雨生欢禧城》"
 },
 {
  "text": "这是我的快乐也是我的泪",
  "kind": "lyric",
  "source": "《Only Once》/《雨生欢禧城》"
 },
 {
  "text": "即使越来越淡的星座和越来越远的神话传说",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "我不会忘记在夏夜的时空遨游",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "爱情的词汇是美丽也无常",
  "kind": "lyric",
  "source": "《我的爱》/《雨生欢禧城》"
 },
 {
  "text": "爱情的诗句是缠绵也虚妄",
  "kind": "lyric",
  "source": "《我的爱》/《雨生欢禧城》"
 },
 {
  "text": "谁能稀释爱情酿的酒",
  "kind": "lyric",
  "source": "《爱过了头》/《雨生欢禧城》"
 },
 {
  "text": "谁能跳过爱情的火圈",
  "kind": "lyric",
  "source": "《爱过了头》/《雨生欢禧城》"
 },
 {
  "text": "像一碰即破的水晶球",
  "kind": "lyric",
  "source": "《爱过了头》/《雨生欢禧城》"
 },
 {
  "text": "他不值得你悲",
  "kind": "lyric",
  "source": "《哭泣与耳语》/《雨生欢禧城》"
 },
 {
  "text": "让阳光晒红你圆圆甜甜笑得正灿烂的脸",
  "kind": "lyric",
  "source": "《哭泣与耳语》/《雨生欢禧城》"
 },
 {
  "text": "滴水穿石与烟花灿烂是不一样的美",
  "kind": "lyric",
  "source": "《传言》/《雨生欢禧城》"
 },
 {
  "text": "有人踩着虚空却歌颂自由",
  "kind": "lyric",
  "source": "《传言》/《雨生欢禧城》"
 },
 {
  "text": "有人怀抱所有却作茧其中",
  "kind": "lyric",
  "source": "《传言》/《雨生欢禧城》"
 },
 {
  "text": "请你转过头我有哭泣的尊严",
  "kind": "lyric",
  "source": "《你赢》/《雨生欢禧城》"
 },
 {
  "text": "你没有权利窥视我的仓皇",
  "kind": "lyric",
  "source": "《你赢》/《雨生欢禧城》"
 },
 {
  "text": "就像我失去了爱你的痴狂",
  "kind": "lyric",
  "source": "《你赢》/《雨生欢禧城》"
 },
 {
  "text": "我是窗口的静物徒留形状看不见灵魂",
  "kind": "lyric",
  "source": "《寂寞》/《雨生欢禧城》"
 },
 {
  "text": "多少的时间流失在眼前",
  "kind": "lyric",
  "source": "《寂寞》/《雨生欢禧城》"
 },
 {
  "text": "日以继夜品尝它苦涩滋味",
  "kind": "lyric",
  "source": "《寂寞》/《雨生欢禧城》"
 },
 {
  "text": "我不需要很确定的方向我只要这段旅程够长",
  "kind": "lyric",
  "source": "《单身旅记》/《雨生欢禧城》"
 },
 {
  "text": "我不需要很飘渺的天堂我只要眼前风景如画",
  "kind": "lyric",
  "source": "《单身旅记》/《雨生欢禧城》"
 },
 {
  "text": "我把爱甩开爱把我甩开",
  "kind": "lyric",
  "source": "《甩开》/《雨生欢禧城》"
 },
 {
  "text": "谁把谁甩开分不太出来",
  "kind": "lyric",
  "source": "《甩开》/《雨生欢禧城》"
 },
 {
  "text": "就把你甩开好像你从来不存在",
  "kind": "lyric",
  "source": "《甩开》/《雨生欢禧城》"
 },
 {
  "text": "眼睛里的水都是灵魂的词汇",
  "kind": "lyric",
  "source": "《眼睛里的湖水》/《雨生欢禧城》"
 },
 {
  "text": "两道晶莹瀑布垂直坠落",
  "kind": "lyric",
  "source": "《眼睛里的湖水》/《雨生欢禧城》"
 },
 {
  "text": "此后只让波纹欢喜灿烂",
  "kind": "lyric",
  "source": "《眼睛里的湖水》/《雨生欢禧城》"
 },
 {
  "text": "如果开始就要继续如果继续只是个谜",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "这些回声又该如何",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "有一道彩虹在你我的心中",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生欢禧城》"
 },
 {
  "text": "天枢天璇天玑天权天衡开阳瑶光",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生欢禧城》"
 },
 {
  "text": "我也正捶打灵魂的雕像",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生欢禧城》"
 },
 {
  "text": "海多深海非深比起相思不算什么",
  "kind": "lyric",
  "source": "《想你》/《如燕盘旋而来的思念》"
 },
 {
  "text": "想你成一道轨迹弯弯曲曲没道理",
  "kind": "lyric",
  "source": "《想你》/《如燕盘旋而来的思念》"
 },
 {
  "text": "一笔一笔看似绢细却相思绵绵无绝期",
  "kind": "lyric",
  "source": "《想你》/《如燕盘旋而来的思念》"
 },
 {
  "text": "想你成一个球体滚来滚去不能停",
  "kind": "lyric",
  "source": "《想你》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我是飘落的枫叶你是仰望的土堆",
  "kind": "lyric",
  "source": "《如燕盘旋而来的思念》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我是月落的声音你是乍醒的黎明",
  "kind": "lyric",
  "source": "《如燕盘旋而来的思念》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我是荒凉的废墟你是湮没的传奇",
  "kind": "lyric",
  "source": "《如燕盘旋而来的思念》/《如燕盘旋而来的思念》"
 },
 {
  "text": "在幸福的瞬间我感觉伟大却又卑微",
  "kind": "lyric",
  "source": "《说的再多你也不了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "在最爱的面前我感觉勇猛却又胆怯",
  "kind": "lyric",
  "source": "《说的再多你也不了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "在感情的棋局里我们都是过河的兵",
  "kind": "lyric",
  "source": "《说的再多你也不了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "在游戏的规则里我与你都不会赢",
  "kind": "lyric",
  "source": "《说的再多你也不了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "若问人生苦求什么事只需记取橙黄橘绿时",
  "kind": "lyric",
  "source": "《凡》/《如燕盘旋而来的思念》"
 },
 {
  "text": "不如共进一觞悠悠然歌唱人生似幻化",
  "kind": "lyric",
  "source": "《凡》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我的心在窃窃私语承认吧难道是爱情",
  "kind": "lyric",
  "source": "《他（依斯玛利）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我想我愿意对他说出我爱你",
  "kind": "lyric",
  "source": "《他（依斯玛利）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "他很平凡表面看来一点也没有魅力",
  "kind": "lyric",
  "source": "《他（依斯玛利）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "如果你上次离开就决定不要回来",
  "kind": "lyric",
  "source": "《no way out》/《如燕盘旋而来的思念》"
 },
 {
  "text": "爱情的酒汁溢满从眼角大肆泛滥",
  "kind": "lyric",
  "source": "《no way out》/《如燕盘旋而来的思念》"
 },
 {
  "text": "因为这是个迷宫你已经陷入其中",
  "kind": "lyric",
  "source": "《no way out》/《如燕盘旋而来的思念》"
 },
 {
  "text": "流什么泪可以洒进自己的心胸",
  "kind": "lyric",
  "source": "《从你到我》/《如燕盘旋而来的思念》"
 },
 {
  "text": "朝什么圣可以升华自己的私情",
  "kind": "lyric",
  "source": "《从你到我》/《如燕盘旋而来的思念》"
 },
 {
  "text": "从你到我有什么不同",
  "kind": "lyric",
  "source": "《从你到我》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我有一种健忘的毛病它不曾困扰过我",
  "kind": "lyric",
  "source": "《健忘》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我分得出想见不想见的面孔",
  "kind": "lyric",
  "source": "《健忘》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我能够等待某人几个小时却遗忘父母也在对我相思",
  "kind": "lyric",
  "source": "《健忘》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我常渴望巴结那类高尚名流却遗忘诚心关切我的是谁",
  "kind": "lyric",
  "source": "《健忘》/《如燕盘旋而来的思念》"
 },
 {
  "text": "缘起缘灭让我的眼眶红了点",
  "kind": "lyric",
  "source": "《一条大街》/《如燕盘旋而来的思念》"
 },
 {
  "text": "这一条大街怎么会曲折绵延",
  "kind": "lyric",
  "source": "《一条大街》/《如燕盘旋而来的思念》"
 },
 {
  "text": "似曾相识的一切仿佛陌生的世界",
  "kind": "lyric",
  "source": "《一条大街》/《如燕盘旋而来的思念》"
 },
 {
  "text": "银河之内我们循着一种轨迹行进",
  "kind": "lyric",
  "source": "《还以为》/《如燕盘旋而来的思念》"
 },
 {
  "text": "还以为你听到我的心如风般的细语",
  "kind": "lyric",
  "source": "《还以为》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我看见我的眼睛散在你的眼睛里",
  "kind": "lyric",
  "source": "《还以为》/《如燕盘旋而来的思念》"
 },
 {
  "text": "伟大是善变的你崇拜着什么",
  "kind": "lyric",
  "source": "《现代启示录（新版）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "美女英雄寂寥身后盖棺却辩不休",
  "kind": "lyric",
  "source": "《现代启示录（新版）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "文明是耀眼的星星但有谁能够否认它的无情",
  "kind": "lyric",
  "source": "《现代启示录（新版）》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我会疯狂你的模样今生最美丽的图像",
  "kind": "lyric",
  "source": "《我会疯狂》/《如燕盘旋而来的思念》"
 },
 {
  "text": "所有声音比不上你萦回我整个的魂灵",
  "kind": "lyric",
  "source": "《我会疯狂》/《如燕盘旋而来的思念》"
 },
 {
  "text": "最初的狂喜与最终的宁谧如此和谐",
  "kind": "lyric",
  "source": "《我会疯狂》/《如燕盘旋而来的思念》"
 },
 {
  "text": "你瑰丽的世界再也不能容许我的存在",
  "kind": "lyric",
  "source": "《我的泪已经流干》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我的泪已经流干我的心怏怏收帆",
  "kind": "lyric",
  "source": "《我的泪已经流干》/《如燕盘旋而来的思念》"
 },
 {
  "text": "任凭它海枯石烂我不再心回意转",
  "kind": "lyric",
  "source": "《我的泪已经流干》/《如燕盘旋而来的思念》"
 },
 {
  "text": "淡水河我的心事流向淡水河",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盘旋而来的思念》"
 },
 {
  "text": "行到水穷我才开始害怕",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盘旋而来的思念》"
 },
 {
  "text": "孑然一身的滋味好不苍凉",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盘旋而来的思念》"
 },
 {
  "text": "快乐是一刻钟当你羞怯的面容泛红",
  "kind": "lyric",
  "source": "《相信》/《如燕盘旋而来的思念》"
 },
 {
  "text": "温柔是一刻钟当你泪洒湿我的衣袖",
  "kind": "lyric",
  "source": "《相信》/《如燕盘旋而来的思念》"
 },
 {
  "text": "拉长的影子里我的心变得不可捉摸",
  "kind": "lyric",
  "source": "《相信》/《如燕盘旋而来的思念》"
 },
 {
  "text": "忧喜是一件两面的衫你穿着一面藏了一面",
  "kind": "lyric",
  "source": "《忧喜是一件双面衫》/《如燕盘旋而来的思念》"
 },
 {
  "text": "思念的绵延如海如天也可以轻易被阳光扫下双眉",
  "kind": "lyric",
  "source": "《忧喜是一件双面衫》/《如燕盘旋而来的思念》"
 },
 {
  "text": "偶尔会疯癫偶尔受不住情绪的自虐",
  "kind": "lyric",
  "source": "《忧喜是一件双面衫》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我依然还在自寻烦恼",
  "kind": "lyric",
  "source": "《even now》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我还把生活过得糜烂糟糕",
  "kind": "lyric",
  "source": "《even now》/《如燕盘旋而来的思念》"
 },
 {
  "text": "还是不曾留意我的心跳一想到你疯狂了",
  "kind": "lyric",
  "source": "《even now》/《如燕盘旋而来的思念》"
 },
 {
  "text": "青春一转身就领着骄傲叛逃",
  "kind": "lyric",
  "source": "《我们如此相爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我们如此相爱所以不会分开",
  "kind": "lyric",
  "source": "《我们如此相爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我的爱随时光凝聚成块等在时空之外",
  "kind": "lyric",
  "source": "《我们如此相爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "知道我们的距离知道我们的差异",
  "kind": "lyric",
  "source": "《爱我正是时候》/《如燕盘旋而来的思念》"
 },
 {
  "text": "但我舍不得走开你有致命的吸引力",
  "kind": "lyric",
  "source": "《爱我正是时候》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我渴望着朝你靠近渴望着与你同行",
  "kind": "lyric",
  "source": "《爱我正是时候》/《如燕盘旋而来的思念》"
 },
 {
  "text": "让我起来奋力打开我要知道门外还有爱",
  "kind": "lyric",
  "source": "《门外还有爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我的眼眸锁定光明的梦一眼望去万里蔚蓝晴空",
  "kind": "lyric",
  "source": "《门外还有爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "花无三日红人无一时穷",
  "kind": "lyric",
  "source": "《门外还有爱》/《如燕盘旋而来的思念》"
 },
 {
  "text": "人来人往日出日落悲喜忧伤都一样",
  "kind": "lyric",
  "source": "《远来的朋友》/《如燕盘旋而来的思念》"
 },
 {
  "text": "总而言之光阴如梭百年终成一页纸张",
  "kind": "lyric",
  "source": "《远来的朋友》/《如燕盘旋而来的思念》"
 },
 {
  "text": "远来的朋友听我说故旧这一路山光水秀我只是失落",
  "kind": "lyric",
  "source": "《远来的朋友》/《如燕盘旋而来的思念》"
 },
 {
  "text": "我爱默默在飞霞里想像历史的轨辙",
  "kind": "lyric",
  "source": "《远来的朋友》/《如燕盘旋而来的思念》"
 },
 {
  "text": "挽着我的手街上走",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盘旋而来的思念》"
 },
 {
  "text": "朝着文明朝着人群朝着青春并肩齐步",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盘旋而来的思念》"
 },
 {
  "text": "就为那夏日将要奔放的恋曲珍惜每一刻永恒",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盘旋而来的思念》"
 },
 {
  "text": "当我的感觉被你了解我便拥有了全世界",
  "kind": "lyric",
  "source": "《当我的感觉被你了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "当你为我开启全世界我才找到我的残缺",
  "kind": "lyric",
  "source": "《当我的感觉被你了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "因为我的快乐是你海天辽阔的笑",
  "kind": "lyric",
  "source": "《当我的感觉被你了解》/《如燕盘旋而来的思念》"
 },
 {
  "text": "朋友啊你的激励的言语牢牢地贴近我心",
  "kind": "lyric",
  "source": "《我学会飞翔》/《青春像把枪》"
 },
 {
  "text": "我学会飞翔飞向最高飞过鹰族的讪笑",
  "kind": "lyric",
  "source": "《我学会飞翔》/《青春像把枪》"
 },
 {
  "text": "我学会去爱爱我的骄傲那是座芬芳环绕的虹桥",
  "kind": "lyric",
  "source": "《我学会飞翔》/《青春像把枪》"
 },
 {
  "text": "少谈些儿女私情，少立些燕雀之志",
  "kind": "writing",
  "source": "雨生亲笔 · 《好小子立志——我看台湾生命力》（1990）"
 },
 {
  "text": "窗外的雨若仍涓密下着，请洗尽他们的悲伤",
  "kind": "writing",
  "source": "雨生亲笔 · 《浴火见证 为林靖娟老师而作》（1992-06-09）"
 },
 {
  "text": "爱不在最美的时刻说，那要在什么时候出口呢",
  "kind": "writing",
  "source": "雨生亲笔 · 《“爱”不在最美的时刻说，那要在什…》（1992-06-16）"
 },
 {
  "text": "反反复覆，走走停停，高高低低，悲悲喜喜",
  "kind": "writing",
  "source": "雨生亲笔 · 《严肃呆板的我写不出好情书》（1992-07-26）"
 },
 {
  "text": "未来是什么？未来是一连串现在的继续",
  "kind": "writing",
  "source": "雨生亲笔 · 《未来是什么？未来是一连串现在的继…》（1992-11-09）"
 },
 {
  "text": "夜到最深处，却是天明的开始",
  "kind": "writing",
  "source": "雨生亲笔 · 《未来是什么？未来是一连串现在的继…》（1992-11-09）"
 },
 {
  "text": "我要站起来给他们看",
  "kind": "writing",
  "source": "雨生亲笔 · 《未来是什么？未来是一连串现在的继…》（1992-11-09）"
 },
 {
  "text": "制作得再精致的皮偶，终究仍是傀儡",
  "kind": "writing",
  "source": "雨生亲笔 · 《未来是什么？未来是一连串现在的继…》（1992-11-09）"
 },
 {
  "text": "生命的痕迹是要用心去拾取的",
  "kind": "writing",
  "source": "雨生亲笔 · 《杂志从淡水小镇走出来》（1993）"
 },
 {
  "text": "愿大家都能把握心底燃烧的时候",
  "kind": "writing",
  "source": "雨生亲笔 · 《杂志从淡水小镇走出来》（1993）"
 },
 {
  "text": "你不能迟疑、你不能犹豫，你抓到机会就坦坦荡荡向前",
  "kind": "writing",
  "source": "雨生亲笔 · 《万米高空》（1993）"
 },
 {
  "text": "你心底有爱就直直率率表白",
  "kind": "writing",
  "source": "雨生亲笔 · 《万米高空》（1993）"
 },
 {
  "text": "你不能心急你不能焦虑，幸福的花蕊别鲁鲁莽莽捏碎",
  "kind": "writing",
  "source": "雨生亲笔 · 《万米高空》（1993）"
 },
 {
  "text": "湿漉漉的草香使我们学会真诚的拥抱",
  "kind": "writing",
  "source": "雨生亲笔 · 《惠铃生日星座诗》（1994）"
 },
 {
  "text": "不羡慕、不埋怨，只须要求自己",
  "kind": "writing",
  "source": "雨生亲笔 · 《成功岭受训家书》（1985-09-07）"
 },
 {
  "text": "要取悦所有的人很难，要贯彻自己的理念很难",
  "kind": "writing",
  "source": "雨生亲笔 · 《应是卡拉期间給歌迷繫雨的一封信》（1994-09-19）"
 },
 {
  "text": "希望这是一个坦然的开始，一个混沌的结束",
  "kind": "writing",
  "source": "雨生亲笔 · 《应是卡拉期间給歌迷繫雨的一封信》（1994-09-19）"
 },
 {
  "text": "希望自己安静的时候安静，表现的时候表现",
  "kind": "writing",
  "source": "雨生亲笔 · 《飞碟音乐杂志元旦寄言》（1995-01-01）"
 },
 {
  "text": "我们都有如胁下生风，飞得又高又远",
  "kind": "writing",
  "source": "雨生亲笔 · 《卡拉OK台北我宣传期间写给歌迷的…》（1995）"
 },
 {
  "text": "艺术倘不能纯粹，我不知那是否仍称为艺术",
  "kind": "writing",
  "source": "雨生亲笔 · 《卡拉OK台北我宣传期间写给歌迷的…》（1995）"
 },
 {
  "text": "何妨学着笑看人生，看看云、听听雨",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "成功，其实是该以平常心看待",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "给自己一个喘息一定会是海阔天空",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "所有外在烦扰也不都只是人生过客，又何必苦苦追求",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "往长远看，或许得就是失，失亦是得",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "不要给自己太多压力，只因太大的压力反而会是阻力",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "让自己轻轻松松、简单快乐的过生活不是很好吗",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "即使只有一盏小灯火，也要建筑心中一片小小乐园",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "挡风遮雨、不忘传送温暖",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "读书是一辈的事",
  "kind": "writing",
  "source": "雨生亲笔 · 《荧幕偶像》（1995）"
 },
 {
  "text": "人生海海，能有几个十年",
  "kind": "writing",
  "source": "雨生亲笔 · 《我的酒娜娜》（1996-01-01）"
 },
 {
  "text": "好好生活，好好珍惜自己，好好把握不可多得的生命",
  "kind": "writing",
  "source": "雨生亲笔 · 《淡水感言》（1996）"
 },
 {
  "text": "再来吧，重新再来吧",
  "kind": "writing",
  "source": "雨生亲笔 · 《淡水感言》（1996）"
 },
 {
  "text": "未来，未来是有无限可能的",
  "kind": "writing",
  "source": "雨生亲笔 · 《下半年？带着爱的花粉种子，随时准…》（1996）"
 },
 {
  "text": "不要轻易低头，不要轻言放弃",
  "kind": "writing",
  "source": "雨生亲笔 · 《下半年？带着爱的花粉种子，随时准…》（1996）"
 },
 {
  "text": "未来是现在的累积",
  "kind": "writing",
  "source": "雨生亲笔 · 《下半年？带着爱的花粉种子，随时准…》（1996）"
 },
 {
  "text": "奋战不懈屡败屡战的精神是必要的",
  "kind": "writing",
  "source": "雨生亲笔 · 《下半年？带着爱的花粉种子，随时准…》（1996）"
 },
 {
  "text": "重要的是在过程中，我们才获得了自信与遭逢横逆的抗压力",
  "kind": "writing",
  "source": "雨生亲笔 · 《下半年？带着爱的花粉种子，随时准…》（1996）"
 },
 {
  "text": "前进的信念应是无入而不自得的境界",
  "kind": "writing",
  "source": "雨生亲笔 · 《开学后心境家书》（1986-03-24）"
 },
 {
  "text": "我尽过全力，我绝不愧对永恒",
  "kind": "writing",
  "source": "雨生亲笔 · 《为口是心非写给丰华老板彭国华先生…》（1997）"
 },
 {
  "text": "巅峰，正是下坠的开始",
  "kind": "writing",
  "source": "雨生亲笔 · 《为口是心非写给丰华老板彭国华先生…》（1997）"
 },
 {
  "text": "忘记过去，放眼将来",
  "kind": "writing",
  "source": "雨生亲笔 · 《为口是心非写给丰华唱片公司工作人…》（1997）"
 },
 {
  "text": "要把每一步，踏得更实在",
  "kind": "writing",
  "source": "雨生亲笔 · 《联合晚报 爱在淡水-口述》（1997-10-22）"
 },
 {
  "text": "人还是应该有梦想",
  "kind": "writing",
  "source": "雨生亲笔 · 《联合晚报 爱在淡水-口述》（1997-10-22）"
 },
 {
  "text": "我的未来，也有梦，不多，但都有实现的可能",
  "kind": "writing",
  "source": "雨生亲笔 · 《联合晚报 爱在淡水-口述》（1997-10-22）"
 },
 {
  "text": "我是乐观的人，对凡事凡物只有顺其自然的态度",
  "kind": "writing",
  "source": "雨生亲笔 · 《我是乐观的人》（1997-10-24）"
 },
 {
  "text": "很多事只想用行动表现，不愿再大声唱高调",
  "kind": "writing",
  "source": "雨生亲笔 · 《商量租房子家书》（1986-12-17）"
 },
 {
  "text": "人的成长就是这样子，你要不停的往前看",
  "kind": "writing",
  "source": "雨生亲笔 · 《成长的故事》（1988）"
 },
 {
  "text": "过去的事，不要给你任何阴影或者是任何压力",
  "kind": "writing",
  "source": "雨生亲笔 · 《成长的故事》（1988）"
 },
 {
  "text": "你要怎么样走出来，这是一个考验",
  "kind": "writing",
  "source": "雨生亲笔 · 《成长的故事》（1988）"
 },
 {
  "text": "这个世界比我所能想象的，还要大很多很多",
  "kind": "writing",
  "source": "雨生亲笔 · 《电台自述 我的童年往事》（1988）"
 },
 {
  "text": "要活就要活得丰富",
  "kind": "writing",
  "source": "雨生亲笔 · 《电台自述 我的童年往事》（1988）"
 },
 {
  "text": "唱歌是一种情感的释放，创作则是理想的实现",

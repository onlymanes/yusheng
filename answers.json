[
 {
  "text": "就为你曾经使我拥有过生命",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "风里吹不乱的是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "宁可让我苦，不愿让你难过",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "为你飞身扑灭那熊熊烈火",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 },
 {
  "text": "如今我才知道，它在我胸口跳动",
  "kind": "lyric",
  "source": "《心底的中国》/《大海》"
 },
 {
  "text": "走出空气污染的地球",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "不求轩不求冕，不为这红尘所囚",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "但我要背向地球，希望寄托整个宇宙",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "看看我的笑容，是不是还保有自我",
  "kind": "lyric",
  "source": "《带我去月球》/《带我去月球》"
 },
 {
  "text": "终日枯坐冥想里，看尽了旁人看不清自己",
  "kind": "lyric",
  "source": "《无题》/《带我去月球》"
 },
 {
  "text": "我就要转弯，我就要看到",
  "kind": "lyric",
  "source": "《我就要转弯》/《带我去月球》"
 },
 {
  "text": "让我化成梦中的精灵",
  "kind": "lyric",
  "source": "《这一夜我睡不着》/《带我去月球》"
 },
 {
  "text": "湖心草深长，我心无处藏",
  "kind": "lyric",
  "source": "《湖心草深长》/《带我去月球》"
 },
 {
  "text": "唱起这首寻常的歌，享受这种寻常的乐",
  "kind": "lyric",
  "source": "《魔幻台北》/《带我去月球》"
 },
 {
  "text": "所以我要现在这样地活着",
  "kind": "lyric",
  "source": "《现在这样》/《带我去月球》"
 },
 {
  "text": "妹妹晚安，我很想念你",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "我想我不会放弃那些有你的记忆",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的鱼》"
 },
 {
  "text": "哲学的答案都是幼稚的分析",
  "kind": "lyric",
  "source": "《青涩的记忆》/《一天到晚游泳的鱼》"
 },
 {
  "text": "有过皆珍贵，生命堪玩味",
  "kind": "lyric",
  "source": "《无知的岁月》/《一天到晚游泳的鱼》"
 },
 {
  "text": "生命的意义升华为对那万物有情的了解明白",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的鱼》"
 },
 {
  "text": "我不想受束缚只要自由自在",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "这是我们的自由",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "爱从不轻易地来，从不轻易走开",
  "kind": "lyric",
  "source": "《爱从不轻易地来》/《自由歌》"
 },
 {
  "text": "让我告诉你云朗天清的地方",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "洒下金黄色的爱，温暖你我的胸怀",
  "kind": "lyric",
  "source": "《我是多么想》/《卡拉OK·台北·我》"
 },
 {
  "text": "霎时灵光拨弄我心弦，甘美思绪如水泻",
  "kind": "lyric",
  "source": "《灵光》/《卡拉OK·台北·我》"
 },
 {
  "text": "好一阵山风，好一轮秋月",
  "kind": "lyric",
  "source": "《子夜纾怀》/《卡拉OK·台北·我》"
 },
 {
  "text": "兄弟呀，我有多么的爱你",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·台北·我》"
 },
 {
  "text": "你给我安慰，我不至颓废",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "你宽容慈悲，我能振翅高飞",
  "kind": "lyric",
  "source": "《后知后觉》/《卡拉OK·台北·我》"
 },
 {
  "text": "总是不能忘记那一种感觉",
  "kind": "lyric",
  "source": "《蝴蝶结》/《卡拉OK·台北·我》"
 },
 {
  "text": "我期待有一天我会回来",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "分合的无奈能换来春夜的天籁",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "昂首阔步，不留一丝遗憾",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·台北·我》"
 },
 {
  "text": "给我一把吉它我来唱",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "给我一对翅膀我来飞",
  "kind": "lyric",
  "source": "《再见，兰花草》/《卡拉OK·台北·我》"
 },
 {
  "text": "你跟得上我吧，你学得还好吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·台北·我》"
 },
 {
  "text": "只剩这首动物的悲歌",
  "kind": "lyric",
  "source": "《动物的悲歌》/《卡拉OK·台北·我》"
 },
 {
  "text": "没你的日子，我习惯为你留盏灯",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "但愿你能是我的最终",
  "kind": "lyric",
  "source": "《不想失去你》/《还是朋友》"
 },
 {
  "text": "即使再冷再寒的雨夜里也有一盏小灯火",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "别放弃希望",
  "kind": "lyric",
  "source": "《别放弃希望》/《还是朋友》"
 },
 {
  "text": "星火燎原，我热情的眼眸曾点亮最灿烂的天空",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "等一等这些伤会自由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "玫瑰多情也多刺，竟与你似曾相识",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "只要能够陪着你我都愿意",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "当你平躺下来，我便成了河",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "等到昏黄，等到痴傻，等着公主吻青蛙",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "如果你要离开我，我想我不会太难过",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "如果你要离开我，世界还是会向前走",
  "kind": "lyric",
  "source": "《如果你要离开我》/《口是心非》"
 },
 {
  "text": "只想让每一分一秒都很美妙",
  "kind": "lyric",
  "source": "《随你》/《口是心非》"
 },
 {
  "text": "若我告诉你其实我爱的只是你",
  "kind": "lyric",
  "source": "《若我告诉你其实我爱的只是你》/《口是心非》"
 },
 {
  "text": "一对指戒，一诺百年",
  "kind": "lyric",
  "source": "《在黄昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "当你的心已累，以为失去了一切",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "其实等在前面还有一整个世界",
  "kind": "lyric",
  "source": "《小时候》/《雨生欢禧城》"
 },
 {
  "text": "快乐的天堂源自心田而非外在",
  "kind": "lyric",
  "source": "《我的爱》/《雨生欢禧城》"
 },
 {
  "text": "风留给春天，云留给雨天",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "心留给世界，人留给岁月",
  "kind": "lyric",
  "source": "《风留给春天》/《雨生欢禧城》"
 },
 {
  "text": "背起行囊我要去远方，远得可以把过去遗忘",
  "kind": "lyric",
  "source": "《单身旅记》/《雨生欢禧城》"
 },
 {
  "text": "迎接明天，擦亮雪亮的尊严",
  "kind": "lyric",
  "source": "《哭泣与耳语》/《雨生欢禧城》"
 },
 {
  "text": "让未知孵化我不渝的信仰",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "总要悠悠岁月还我本来容颜",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "凡已做过的事不消失，凡真爱过的情尽成痴",
  "kind": "lyric",
  "source": "《凡》/《如燕盘旋而来的思念》"
 },
 {
  "text": "总在凌晨四点，才能诉说最美丽的语言",
  "kind": "lyric",
  "source": "《如燕盘旋而来的思念》/《如燕盘旋而来的思念》"
 },
 {
  "text": "凡是走过，必定留下或深或浅的痕迹",
  "kind": "lyric",
  "source": "《还以为》/《如燕盘旋而来的思念》"
 },
 {
  "text": "常常在星空下想你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "常常在晚风中说你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "把精巧日记本轻轻拿起",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "用小锁打开琳琅满目的回忆",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "缠绵的梦境里有你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "忧郁的只是我想你念你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "心里装满相思不尽的失迷",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "偷偷在倩笑里寻你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "深深在心版上写你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "你爱在沙滩上对流星轻语",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "说这一生一世永成美丽印记",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "在爱的坚贞里是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "为心情流泪的是你",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "害怕会带给你太多的愁悒",
  "kind": "lyric",
  "source": "《就为你》/《想念我》"
 },
 {
  "text": "他们满脸风霜，他们眼神迷茫",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们箕踞围坐，他们孤独蜷缩",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们蹒跚的步履踩过整个中国",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们交迭的皱纹是历史的迹痕",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们黑光的唇齿舐过泥泞雨血",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们抖颤的双手曾在炮火下穿梭",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "总在朝霞未升，他们就已起身",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "露珠不及亲吻，大地已被汗水湿润",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "穿着粗布的宽衣，走在纵横的田梗",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "吐着浓浓的烟雾，恣任冥思出神",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "灿烂的阳光温暖不到这样的角落",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "一个惨被自私的文明遗忘的角落",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "每当我一眼瞥见他们，就感到心头一阵隐痛",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "毕竟生命的历练，不是旁人随便就能够体会",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们以前也念过诗书，也谈过恋爱",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "也拥有天伦拥有工作，和自己的一片天空",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "他们今天有山上种树，有厕所收钱",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "也有人卖面卖臭豆腐，和自己的风烛残年",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "但当到我知道他是抗战中的无名英雄",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "我一身罪愆，难是卑微良心所能抚慰",
  "kind": "lyric",
  "source": "《他们》/《想念我》"
 },
 {
  "text": "你心里忧郁你在哭泣",
  "kind": "lyric",
  "source": "《宁可让我苦》/《大海》"
 }
]
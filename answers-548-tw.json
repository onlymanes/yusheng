[
 {
  "text": "就爲你曾經使我擁有過生命",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "風裏吹不亂的是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "寧可讓我苦，不願讓你難過",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "爲你飛身撲滅那熊熊烈火",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "如今我才知道，它在我胸口跳動",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "走出空氣污染的地球",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "不求軒不求冕，不爲這紅塵所囚",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "但我要背向地球，希望寄託整個宇宙",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "看看我的笑容，是不是還保有自我",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "終日枯坐冥想裏，看盡了旁人看不清自己",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "我就要轉彎，我就要看到",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "讓我化成夢中的精靈",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "湖心草深長，我心無處藏",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "唱起這首尋常的歌，享受這種尋常的樂",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "所以我要現在這樣地活着",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "妹妹晚安，我很想念你",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "我想我不會放棄那些有你的記憶",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "哲學的答案都是幼稚的分析",
  "kind": "lyric",
  "source": "《青澀的記憶》/《一天到晚游泳的魚》"
 },
 {
  "text": "有過皆珍貴，生命堪玩味",
  "kind": "lyric",
  "source": "《無知的歲月》/《一天到晚游泳的魚》"
 },
 {
  "text": "生命的意義昇華爲對那萬物有情的瞭解明白",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的魚》"
 },
 {
  "text": "我不想受束縛只要自由自在",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "這是我們的自由",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "愛從不輕易地來，從不輕易走開",
  "kind": "lyric",
  "source": "《愛從不輕易地來》/《自由歌》"
 },
 {
  "text": "讓我告訴你雲朗天清的地方",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "灑下金黃色的愛，溫暖你我的胸懷",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "霎時靈光撥弄我心絃，甘美思緒如水瀉",
  "kind": "lyric",
  "source": "《靈光》/《卡拉OK·臺北·我》"
 },
 {
  "text": "好一陣山風，好一輪秋月",
  "kind": "lyric",
  "source": "《子夜紓懷》/《卡拉OK·臺北·我》"
 },
 {
  "text": "兄弟呀，我有多麼的愛你",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你給我安慰，我不至頹廢",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你寬容慈悲，我能振翅高飛",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "總是不能忘記那一種感覺",
  "kind": "lyric",
  "source": "《蝴蝶結》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我期待有一天我會回來",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "分合的無奈能換來春夜的天籟",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "昂首闊步，不留一絲遺憾",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "給我一把吉它我來唱",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "給我一對翅膀我來飛",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你跟得上我吧，你學得還好吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·臺北·我》"
 },
 {
  "text": "只剩這首動物的悲歌",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "沒你的日子，我習慣爲你留盞燈",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "但願你能是我的最終",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "即使再冷再寒的雨夜裏也有一盞小燈火",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "別放棄希望",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "星火燎原，我熱情的眼眸曾點亮最燦爛的天空",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "等一等這些傷會自由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "玫瑰多情也多刺，竟與你似曾相識",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "只要能夠陪着你我都願意",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "當你平躺下來，我便成了河",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "等到昏黃，等到癡傻，等着公主吻青蛙",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "如果你要離開我，我想我不會太難過",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "如果你要離開我，世界還是會向前走",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "只想讓每一分一秒都很美妙",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "若我告訴你其實我愛的只是你",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "一對指戒，一諾百年",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "當你的心已累，以爲失去了一切",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "其實等在前面還有一整個世界",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "快樂的天堂源自心田而非外在",
  "kind": "lyric",
  "source": "《我的愛》/《雨生歡禧城》"
 },
 {
  "text": "風留給春天，雲留給雨天",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "心留給世界，人留給歲月",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "背起行囊我要去遠方，遠得可以把過去遺忘",
  "kind": "lyric",
  "source": "《單身旅記》/《雨生歡禧城》"
 },
 {
  "text": "迎接明天，擦亮雪亮的尊嚴",
  "kind": "lyric",
  "source": "《哭泣與耳語》/《雨生歡禧城》"
 },
 {
  "text": "讓未知孵化我不渝的信仰",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "總要悠悠歲月還我本來容顏",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "凡已做過的事不消失，凡真愛過的情盡成癡",
  "kind": "lyric",
  "source": "《凡》/《如燕盤旋而來的思念》"
 },
 {
  "text": "總在凌晨四點，才能訴說最美麗的語言",
  "kind": "lyric",
  "source": "《如燕盤旋而來的思念》/《如燕盤旋而來的思念》"
 },
 {
  "text": "凡是走過，必定留下或深或淺的痕跡",
  "kind": "lyric",
  "source": "《還以爲》/《如燕盤旋而來的思念》"
 },
 {
  "text": "常常在星空下想你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "常常在晚風中說你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "把精巧日記本輕輕拿起",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "用小鎖打開琳琅滿目的回憶",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "纏綿的夢境裏有你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "憂鬱的只是我想你念你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "心裏裝滿相思不盡的失迷",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "偷偷在倩笑裏尋你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "深深在心版上寫你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "你愛在沙灘上對流星輕語",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "說這一生一世永成美麗印記",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "在愛的堅貞裏是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "爲心情流淚的是你",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "害怕會帶給你太多的愁悒",
  "kind": "lyric",
  "source": "《就爲你》/《想念我》"
 },
 {
  "text": "他們滿臉風霜，他們眼神迷茫",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們箕踞圍坐，他們孤獨蜷縮",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們蹣跚的步履踩過整個中國",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們交迭的皺紋是歷史的跡痕",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們黑光的脣齒舐過泥濘雨血",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們抖顫的雙手曾在炮火下穿梭",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "總在朝霞未升，他們就已起身",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "露珠不及親吻，大地已被汗水溼潤",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "穿着粗布的寬衣，走在縱橫的田梗",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "吐着濃濃的煙霧，恣任冥思出神",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "燦爛的陽光溫暖不到這樣的角落",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "一個慘被自私的文明遺忘的角落",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "每當我一眼瞥見他們，就感到心頭一陣隱痛",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "畢竟生命的歷練，不是旁人隨便就能夠體會",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們以前也念過詩書，也談過戀愛",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "也擁有天倫擁有工作，和自己的一片天空",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "他們今天有山上種樹，有廁所收錢",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "也有人賣面賣臭豆腐，和自己的風燭殘年",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "但當到我知道他是抗戰中的無名英雄",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "我一身罪愆，難是卑微良心所能撫慰",
  "kind": "lyric",
  "source": "《他們》/《想念我》"
 },
 {
  "text": "你心裏憂鬱你在哭泣",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "我守在一邊希望你能歡喜",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "你紅腫眼睛告訴我關懷祈語",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "並不是此刻最需要的東西",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "你閉起眼睛暗示我濃情深意",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "並不能回答這進退不得的難題",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "我可以愁我可以痛",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "要你滿腔心碎的淚不用再流",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "你怎麼愁我怎麼痛",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "要在一身風絮以後才能悟懂",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "這世界似乎沒有恆久的情",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "讓電話持續我不禁捏緊手心",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "想告訴你這一切會有個不差的結局",
  "kind": "lyric",
  "source": "《寧可讓我苦》/《大海》"
 },
 {
  "text": "我沒有走過父親走過的長路",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "他的年少是幾番滄桑幾番血淚",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "我沒有看過父親看過的國土",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "他的鄉愁是浩蕩之江滾滾之水",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "我只能偷偷瞄着父親的眼眸",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "感覺他眼光最深沉處的浮雲蒼狗",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "我沒有留下父親留下的瘡疤",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "他的傷痕是不敢思憶不堪回首",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "我沒有經歷父親經歷的掙扎",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "他的割捨是午夜夢迴茫然失落",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "我只有悄悄等着父親的動容",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "感覺他神色最恍惚間的愛恨交錯",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "什麼叫中國我曾經沒有把握",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "什麼叫中國我現在真有把握",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "是父親畢生的守候我與生俱來的光榮",
  "kind": "lyric",
  "source": "《心底的中國》/《大海》"
 },
 {
  "text": "走馬觀花日子裏",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "從未留下深刻記憶",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "終究時間耗盡",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "才知皮相的生命",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "是要去深掘的古井",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "在生與死的邊際",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "躲在等待的後面",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "我無知的手遮着歲月的容顏",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "手記分割了思維",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "是對未來無色預言",
  "kind": "lyric",
  "source": "《無題》/《帶我去月球》"
 },
 {
  "text": "走出紛爭喧擾的生活",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "因爲漫天黑煙腐蝕掉我的夢",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "因爲征戰殺伐我就快要沒有朋友",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "帶我去月球那裏空氣稀薄",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "帶我去月球充滿原始坑洞",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "帶我去月球重力輕浮你我",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "掙扎在一片荒漠也不見嫦娥相從",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "看我虛步玲瓏躡星空",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "我愛醉臥亭臺作風流",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "只是狂歌一曲恍惚間就化入無窮",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "將進酒杯莫停",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "人生不過一場大夢",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "看看我的瞳孔還燃不燃燒焰火",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "下弦月上弦月就讓我被月蝕吞沒",
  "kind": "lyric",
  "source": "《帶我去月球》/《帶我去月球》"
 },
 {
  "text": "這一夜我睡不着",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "隨便彈一些舊曲調",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "這一夜我好心焦",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "你的身影在我眼前飄",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "不知道你好不好",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "美麗的臉有點憔悴與煩惱",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "我向窗外星空幽幽呼叫",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "我將知道你的不安的尋找",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "再變成你的溫柔的微笑",
  "kind": "lyric",
  "source": "《這一夜我睡不着》/《帶我去月球》"
 },
 {
  "text": "轉過那個彎就可以看到",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我不停地絆倒止不住的心焦",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "以爲生命在那裏會有成就的驕傲",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "轉過那個彎就可以知道",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我收拾起執拗不再堅持思考",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "幻想生命在那裏獲得脫俗的清高",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "但我從來想象不到",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "那個彎的崎嶇好比在我心中插滿了刀",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我一路走一路拔",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我就要轉彎我就要知道",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "卻赫然躑躅腳步質疑那是怎麼樣的目標",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "真正的世界在那個彎道",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我搖頭晃腦實在莫名其妙",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "可能生命在那裏纔有實現的必要",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "文明的社會在那個彎道",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我有一點苦惱我有一點混淆",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "希望生命在那裏展示血熱的激潮",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "但我從來意料不到",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "那個彎的顛躓好比在我耳旁淒厲的呼嘯",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "我一路走一路遮",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "仍然對路旁的屍骨默唸和平的晚禱",
  "kind": "lyric",
  "source": "《我就要轉彎》/《帶我去月球》"
 },
 {
  "text": "小小的年紀",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "猛打翻滾沾一身草青",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "昂首高歌誰說不神氣",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "山菊兀自迎風搖曳",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "老牛眼神一陣調皮",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "竊笑着踩過未乾水泥地的蹄印",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "有很多朋友都是些小人物卻從來不煩憂",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "往海里丟淚水和懵懂",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "嬉戲雷雨過的午後",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "種種詼諧中的稚幼",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "模糊又熟悉多時的面孔",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "少年擊劍更吹簫不愛財寶愛英豪",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "少年吟詩更風騷不羨人間羨唐朝",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "少年狂狷更急躁不知跋扈知炫耀",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "去日苦多的時候",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "青青子衿悠悠行吟過今昔",
  "kind": "lyric",
  "source": "《總髮遊》/《帶我去月球》"
 },
 {
  "text": "守着春天的火焰",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "笑問天上的雲霞",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "我該不該細細想她",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "疏星幾點新月淡",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "路上沒有夜行人",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "看我不喜也不悲",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "我想這樣告訴她",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "不避夏日的酷熱",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "騎車頂着豔陽天",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "我該不該輕輕問她",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "凡路總會有盡頭",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "凡人總要有歸向",
  "kind": "lyric",
  "source": "《湖心草深長》/《帶我去月球》"
 },
 {
  "text": "你說臺北從來不曾下過一場雪",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "我說我能明白季節常恆之理",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你何須太自貶",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你說臺北真看不見無際的綠野",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "我說我能明白文明工斧之苦",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你不必太在意",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你猜臺北將來可有自己的音樂",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "我看文化變遷不是一天兩天",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你千萬別心虛",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "終究臺北會有一個特殊的空間",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "我看是好是壞還在未定之天",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "你千萬別心急",
  "kind": "lyric",
  "source": "《魔幻臺北》/《帶我去月球》"
 },
 {
  "text": "有一陣的眩昏",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "我是追逐綠洲的旅人",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "深夜裏等閃逝的星",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "我是守候火炬的獵人",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "什麼急什麼緩",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "什麼不慌不亂",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "當我鼓足勇氣衝向心底的終站",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "失去與獲得會帶來多少快樂",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "我對愛曾懂得幾分",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "依稀有過濃稠的愁恨",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "我對人世曾懂得幾分",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "也是吐過血性的激憤",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "什麼深什麼淺",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "什麼糾結纏綿",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "當我披掛上陣用力嘶喊過來",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "勝利與失敗會留下多少傷害",
  "kind": "lyric",
  "source": "《現在這樣》/《帶我去月球》"
 },
 {
  "text": "年少的時候，誰說沒煩憂",
  "kind": "lyric",
  "source": "《青澀的記憶》/《一天到晚游泳的魚》"
 },
 {
  "text": "不曾深愛過，不曾追求過",
  "kind": "lyric",
  "source": "《青澀的記憶》/《一天到晚游泳的魚》"
 },
 {
  "text": "一夥臭朋友徜徉夕陽中",
  "kind": "lyric",
  "source": "《青澀的記憶》/《一天到晚游泳的魚》"
 },
 {
  "text": "脫殼的蛻變竟需要生命歷練",
  "kind": "lyric",
  "source": "《冰點》/《一天到晚游泳的魚》"
 },
 {
  "text": "而一天天地成熟在許多痛苦尖銳的打擊",
  "kind": "lyric",
  "source": "《冰點》/《一天到晚游泳的魚》"
 },
 {
  "text": "愛談天也愛白日夢",
  "kind": "lyric",
  "source": "《冰點》/《一天到晚游泳的魚》"
 },
 {
  "text": "一夥臭朋友徜徉冰冷中",
  "kind": "lyric",
  "source": "《冰點》/《一天到晚游泳的魚》"
 },
 {
  "text": "真怕你認不得我的改變",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "家裏格局仍一樣，只是少了你的牀",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "寒夜裏是否有人與你爲伴",
  "kind": "lyric",
  "source": "《妹妹晚安》/《一天到晚游泳的魚》"
 },
 {
  "text": "當風和日麗，陽春三月天",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的魚》"
 },
 {
  "text": "繽紛的足跡，飛揚的笑靨",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的魚》"
 },
 {
  "text": "一夥臭朋友徜徉詩意中",
  "kind": "lyric",
  "source": "《三月的天真》/《一天到晚游泳的魚》"
 },
 {
  "text": "風過樹林，突然我們尋到默契",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的魚》"
 },
 {
  "text": "天朗氣清，彷彿前世我們已相遇",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的魚》"
 },
 {
  "text": "就這麼繼續，讓我們的心靈慢慢地累積那種情緒",
  "kind": "lyric",
  "source": "《一步一徘徊》/《一天到晚游泳的魚》"
 },
 {
  "text": "但鳳凰花開後，卻是一番離別",
  "kind": "lyric",
  "source": "《仲夏夜之夢》/《一天到晚游泳的魚》"
 },
 {
  "text": "遠離了童年，不能說沒感覺",
  "kind": "lyric",
  "source": "《仲夏夜之夢》/《一天到晚游泳的魚》"
 },
 {
  "text": "而人不能戀舊，我們又必須往前",
  "kind": "lyric",
  "source": "《仲夏夜之夢》/《一天到晚游泳的魚》"
 },
 {
  "text": "我曾經戀愛過，我曾經憂愁過",
  "kind": "lyric",
  "source": "《無知的歲月》/《一天到晚游泳的魚》"
 },
 {
  "text": "而一天天的沉浮在，過去未來複雜的聯想",
  "kind": "lyric",
  "source": "《無知的歲月》/《一天到晚游泳的魚》"
 },
 {
  "text": "不再問爲什麼，不挑剔已擁有",
  "kind": "lyric",
  "source": "《無知的歲月》/《一天到晚游泳的魚》"
 },
 {
  "text": "讓我握住你瘦骨嶙峋的小手",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "讓我指引你觸手可及的天堂",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "同你一樣跳動，同你一樣顫抖",
  "kind": "lyric",
  "source": "《我是多麼想》/《卡拉OK·臺北·我》"
 },
 {
  "text": "形影不離天不怕地不怕",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "快樂的日子卻並沒有很長，萬丈高樓大廈遮住金黃的陽光",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "直到那天他們找不到媽媽",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "小黑站在小花冰冷的身體旁",
  "kind": "lyric",
  "source": "《動物的悲歌》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我珍藏的記憶，隨風輕撫心靈",
  "kind": "lyric",
  "source": "《靈光》/《卡拉OK·臺北·我》"
 },
 {
  "text": "羅網交織出優美側面，擷取這大塊的瞬間",
  "kind": "lyric",
  "source": "《靈光》/《卡拉OK·臺北·我》"
 },
 {
  "text": "速寫此刻給此心此身的溫柔",
  "kind": "lyric",
  "source": "《靈光》/《卡拉OK·臺北·我》"
 },
 {
  "text": "不可以世俗斗量的情感",
  "kind": "lyric",
  "source": "《永公街的街長》/《卡拉OK·臺北·我》"
 },
 {
  "text": "永公街的街長，他是文明社會的罪與罰",
  "kind": "lyric",
  "source": "《永公街的街長》/《卡拉OK·臺北·我》"
 },
 {
  "text": "永公街的街長，像只漂鳥因固執的追尋而跌下",
  "kind": "lyric",
  "source": "《永公街的街長》/《卡拉OK·臺北·我》"
 },
 {
  "text": "好一個夢般子夜，細忖我們的是非",
  "kind": "lyric",
  "source": "《子夜紓懷》/《卡拉OK·臺北·我》"
 },
 {
  "text": "野火般婆娑，天空般寬容",
  "kind": "lyric",
  "source": "《子夜紓懷》/《卡拉OK·臺北·我》"
 },
 {
  "text": "狂熱的自由，冰冷的靜默",
  "kind": "lyric",
  "source": "《子夜紓懷》/《卡拉OK·臺北·我》"
 },
 {
  "text": "因爲失去要比擁有容易",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我們背對背前行，朝着路的兩端走去",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·臺北·我》"
 },
 {
  "text": "年長以後談笑起，那少不更事的意氣",
  "kind": "lyric",
  "source": "《兄弟呀》/《卡拉OK·臺北·我》"
 },
 {
  "text": "太陽燒紅了海洋，海洋包容了太陽",
  "kind": "lyric",
  "source": "《這一年這一夜》/《卡拉OK·臺北·我》"
 },
 {
  "text": "這一年這一夜，回憶溫暖我疲憊",
  "kind": "lyric",
  "source": "《這一年這一夜》/《卡拉OK·臺北·我》"
 },
 {
  "text": "看似清實迷離，情路又玄又是漩",
  "kind": "lyric",
  "source": "《這一年這一夜》/《卡拉OK·臺北·我》"
 },
 {
  "text": "愛與恨癡與嗔，你不用再區分也不必再等",
  "kind": "lyric",
  "source": "《我的心在發燙》/《卡拉OK·臺北·我》"
 },
 {
  "text": "天天想天天都一樣，我用熱情懷抱希望",
  "kind": "lyric",
  "source": "《我的心在發燙》/《卡拉OK·臺北·我》"
 },
 {
  "text": "愛得慌，我無處可藏",
  "kind": "lyric",
  "source": "《我的心在發燙》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你披星戴月，你不辭冰雪",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你像遠在天邊，又似近在眼前",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你不告而別，我才後知後覺",
  "kind": "lyric",
  "source": "《後知後覺》/《卡拉OK·臺北·我》"
 },
 {
  "text": "燙金的滾邊，墨綠的絨面",
  "kind": "lyric",
  "source": "《蝴蝶結》/《卡拉OK·臺北·我》"
 },
 {
  "text": "終於還是回到玻璃櫥窗前",
  "kind": "lyric",
  "source": "《蝴蝶結》/《卡拉OK·臺北·我》"
 },
 {
  "text": "然而現在這個蝴蝶結，卻靜靜躺在心靈的深淵",
  "kind": "lyric",
  "source": "《蝴蝶結》/《卡拉OK·臺北·我》"
 },
 {
  "text": "就問我這些日子來是否心依舊",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我大半的時間裏，都存在你左右",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你跟得上我吧，你還習慣我吧",
  "kind": "lyric",
  "source": "《跟得上我吧》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我情願現在與未來，能充滿秋涼的爽快",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "前前後後，迂迂迴回地試探",
  "kind": "lyric",
  "source": "《我期待》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我就是不能忘掉那盆蘭花草",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "梵音在弦外，醉翁意韻妙",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "你只要給我五分鐘，我給你完全不同的感受",
  "kind": "lyric",
  "source": "《再見，蘭花草》/《卡拉OK·臺北·我》"
 },
 {
  "text": "我有一點無聊，我有一點寂寞",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "我閒了就工作，我累了就出遊",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "政治是什麼，民主怎麼做",
  "kind": "lyric",
  "source": "《自由歌》/《自由歌》"
 },
 {
  "text": "我從不輕易地愛，從不輕言要離開",
  "kind": "lyric",
  "source": "《愛從不輕易地來》/《自由歌》"
 },
 {
  "text": "晨曦的美就是一種愛",
  "kind": "lyric",
  "source": "《愛從不輕易地來》/《自由歌》"
 },
 {
  "text": "深藍的星夜也是一種愛",
  "kind": "lyric",
  "source": "《愛從不輕易地來》/《自由歌》"
 },
 {
  "text": "你來的時候伴隨山茶的清芬",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "日升月落風起雲湧轉眼空",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "當我想起紅塵瞬變心底好難過",
  "kind": "lyric",
  "source": "《不想失去你》/《還是朋友》"
 },
 {
  "text": "回到初相見那一天我們多靦腆",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "微笑似清水激盪起如詩的迴旋",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "當愛在空中飄當雪從山巔融化掉",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "我守在記憶的窗口",
  "kind": "lyric",
  "source": "《別放棄希望》/《還是朋友》"
 },
 {
  "text": "堅持在浩瀚人生巨流裏前航",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "回首的剎那請容許我猖狂",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "短促的美麗也深烙印生命",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "不同的歲月是不同的字句",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "過去我不羈的豪情在汗淚中前進",
  "kind": "lyric",
  "source": "《未知》/《白色才情》"
 },
 {
  "text": "小陳風塵僕僕劃破臘寒而來",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "她想走就讓她走留來留去留成仇",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "求她的話我說不出口",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "她想做就該她做守到最後也沒有用",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "感情在長久不在強求愛她就要任她悠遊",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "異國的風雪是故鄉的戀人沒有辦法遮掩呵護的世界",
  "kind": "lyric",
  "source": "《再見女郎》/《白色才情》"
 },
 {
  "text": "斜的橫的都是畫",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "胭脂沾惹雙鬢生香",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "學飛蛾撲向火光",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "在眉宇之間啼吟她的羞嬌",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "就撲拍翅膀奔向她的懷抱",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "此生願爲她囚進籠牢",
  "kind": "lyric",
  "source": "《後窗》/《白色才情》"
 },
 {
  "text": "一時之間我遺失了語言",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "誰不在等待他的貝德麗採",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "如果你柔情的雙眼懸掛在天邊",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "我也要散盡所有力氣雄雄爲你搏一回",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "你讓我發暈發到了最高點",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "你讓我從早到晚瘋瘋癲癲",
  "kind": "lyric",
  "source": "《發暈》/《白色才情》"
 },
 {
  "text": "只讓陽光慢慢燙一夜寂寞的冰涼",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "總在靈魂深處藏了一些喜悲",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "喝了酒會有點醉愛人走了掉眼淚",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "但我擋不住潮水將沉默往我心裏堆",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "卻把重重悵惘枕在自己肩上",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "愛是空氣也是瘟疫",
  "kind": "lyric",
  "source": "《沉默之沙》/《白色才情》"
 },
 {
  "text": "也許有一點點難過至少不會在你的面前難過",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "就算我真的很心痛至少臉上還掛着一幅笑容",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "也許它慢慢改變我至少改變也不是壞的結果",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "如果你要離開請別到最後一刻才告訴我",
  "kind": "lyric",
  "source": "《如果你要離開我》/《口是心非》"
 },
 {
  "text": "口是心非你深情的承諾都隨着西風飄渺遠走",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "晴天霹靂你絕情的放手在我最需要你的時候",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "於是愛恨交錯人消瘦",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "怕是怕這些苦沒來由",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "於是悲歡起落人靜默",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "渾然天成我純情的悸動曾奔放最滾燙的節奏",
  "kind": "lyric",
  "source": "《口是心非》/《口是心非》"
 },
 {
  "text": "時間過得快愛得太奇怪",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "直到我們一再目送彼此消失於人海之外",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "我想我的愚昧都被你容在桶內",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "白淨的紙讓我若有所思若有所失若有所癡",
  "kind": "lyric",
  "source": "《Cappuccino》/《口是心非》"
 },
 {
  "text": "有時候嬌橫傷人有時候嬌柔依人",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我只能用最奢侈的玻璃爲你築起不懼風雨的天地",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我就是你忠實的園丁",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "我像聖堂下爲你禁慾的僧侶",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "即使你寧可自由自在呼吸那一窗星星",
  "kind": "lyric",
  "source": "《玫瑰的名字》/《口是心非》"
 },
 {
  "text": "聚爲一泓泉水深邃清澈",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "我是朝聖的人我是客途的雁卻一往情深",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "從此無意追逐新綠的春",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "天曾缺掉的角無非此等神采",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "你正頷首告知這裏有愛",
  "kind": "lyric",
  "source": "《河》/《口是心非》"
 },
 {
  "text": "最美麗的季節裏我們初相遇",
  "kind": "lyric",
  "source": "《···的圖案》/《口是心非》"
 },
 {
  "text": "就在至高的峯頂我們風化了愛情",
  "kind": "lyric",
  "source": "《···的圖案》/《口是心非》"
 },
 {
  "text": "當我不慎任她下墜赤道也疊起了雪",
  "kind": "lyric",
  "source": "《···的圖案》/《口是心非》"
 },
 {
  "text": "轉開我發熱的身體足足地球的半徑",
  "kind": "lyric",
  "source": "《···的圖案》/《口是心非》"
 },
 {
  "text": "我的心隨你牽引隨你歡喜而歡喜",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "隨你愛隨你恨隨你一意孤行我都願意",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "我的夢隨你擁有隨你哀愁而哀愁",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "隨你癡隨你怨隨你漫天遨遊我不退縮",
  "kind": "lyric",
  "source": "《隨你》/《口是心非》"
 },
 {
  "text": "你的溫柔你的輪廓你的灑脫在我心底都是飄逸水墨",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "因爲太難以形容只能對着自己說",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "神采我最愛躲在夢裏喃喃念出來",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "你的言語你的歡聲你的呼吸播放一種巴洛克的旋律",
  "kind": "lyric",
  "source": "《神采》/《口是心非》"
 },
 {
  "text": "當月光歌頌着絕倫的天上詩篇",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "相思會醉愛戀能癡",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "在星辰造型出神聖的幾何以前",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "所以你說你情願迎接繁複的柴米油鹽",
  "kind": "lyric",
  "source": "《在黃昏融化了世界的色彩以前》/《口是心非》"
 },
 {
  "text": "你讓我驚喜你的自信",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "你已不是你當你急於要改變自己",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "你就是你就是你獨一不二的你",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "何不就把你淋漓盡致地秀出去",
  "kind": "lyric",
  "source": "《若我告訴你其實我愛的只是你》/《口是心非》"
 },
 {
  "text": "在午夜過後的風雨裏不由自主的想着你",
  "kind": "lyric",
  "source": "《Only Once》/《雨生歡禧城》"
 },
 {
  "text": "這是我的快樂也是我的淚",
  "kind": "lyric",
  "source": "《Only Once》/《雨生歡禧城》"
 },
 {
  "text": "即使越來越淡的星座和越來越遠的神話傳說",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "我不會忘記在夏夜的時空遨遊",
  "kind": "lyric",
  "source": "《小時候》/《雨生歡禧城》"
 },
 {
  "text": "愛情的詞彙是美麗也無常",
  "kind": "lyric",
  "source": "《我的愛》/《雨生歡禧城》"
 },
 {
  "text": "愛情的詩句是纏綿也虛妄",
  "kind": "lyric",
  "source": "《我的愛》/《雨生歡禧城》"
 },
 {
  "text": "誰能稀釋愛情釀的酒",
  "kind": "lyric",
  "source": "《愛過了頭》/《雨生歡禧城》"
 },
 {
  "text": "誰能跳過愛情的火圈",
  "kind": "lyric",
  "source": "《愛過了頭》/《雨生歡禧城》"
 },
 {
  "text": "像一碰即破的水晶球",
  "kind": "lyric",
  "source": "《愛過了頭》/《雨生歡禧城》"
 },
 {
  "text": "他不值得你悲",
  "kind": "lyric",
  "source": "《哭泣與耳語》/《雨生歡禧城》"
 },
 {
  "text": "讓陽光曬紅你圓圓甜甜笑得正燦爛的臉",
  "kind": "lyric",
  "source": "《哭泣與耳語》/《雨生歡禧城》"
 },
 {
  "text": "滴水穿石與煙花燦爛是不一樣的美",
  "kind": "lyric",
  "source": "《傳言》/《雨生歡禧城》"
 },
 {
  "text": "有人踩着虛空卻歌頌自由",
  "kind": "lyric",
  "source": "《傳言》/《雨生歡禧城》"
 },
 {
  "text": "有人懷抱所有卻作繭其中",
  "kind": "lyric",
  "source": "《傳言》/《雨生歡禧城》"
 },
 {
  "text": "請你轉過頭我有哭泣的尊嚴",
  "kind": "lyric",
  "source": "《你贏》/《雨生歡禧城》"
 },
 {
  "text": "你沒有權利窺視我的倉皇",
  "kind": "lyric",
  "source": "《你贏》/《雨生歡禧城》"
 },
 {
  "text": "就像我失去了愛你的癡狂",
  "kind": "lyric",
  "source": "《你贏》/《雨生歡禧城》"
 },
 {
  "text": "我是窗口的靜物徒留形狀看不見靈魂",
  "kind": "lyric",
  "source": "《寂寞》/《雨生歡禧城》"
 },
 {
  "text": "多少的時間流失在眼前",
  "kind": "lyric",
  "source": "《寂寞》/《雨生歡禧城》"
 },
 {
  "text": "日以繼夜品嚐它苦澀滋味",
  "kind": "lyric",
  "source": "《寂寞》/《雨生歡禧城》"
 },
 {
  "text": "我不需要很確定的方向我只要這段旅程夠長",
  "kind": "lyric",
  "source": "《單身旅記》/《雨生歡禧城》"
 },
 {
  "text": "我不需要很飄渺的天堂我只要眼前風景如畫",
  "kind": "lyric",
  "source": "《單身旅記》/《雨生歡禧城》"
 },
 {
  "text": "我把愛甩開愛把我甩開",
  "kind": "lyric",
  "source": "《甩開》/《雨生歡禧城》"
 },
 {
  "text": "誰把誰甩開分不太出來",
  "kind": "lyric",
  "source": "《甩開》/《雨生歡禧城》"
 },
 {
  "text": "就把你甩開好像你從來不存在",
  "kind": "lyric",
  "source": "《甩開》/《雨生歡禧城》"
 },
 {
  "text": "眼睛裏的水都是靈魂的詞彙",
  "kind": "lyric",
  "source": "《眼睛裏的湖水》/《雨生歡禧城》"
 },
 {
  "text": "兩道晶瑩瀑布垂直墜落",
  "kind": "lyric",
  "source": "《眼睛裏的湖水》/《雨生歡禧城》"
 },
 {
  "text": "此後只讓波紋歡喜燦爛",
  "kind": "lyric",
  "source": "《眼睛裏的湖水》/《雨生歡禧城》"
 },
 {
  "text": "如果開始就要繼續如果繼續只是個謎",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "這些回聲又該如何",
  "kind": "lyric",
  "source": "《風留給春天》/《雨生歡禧城》"
 },
 {
  "text": "有一道彩虹在你我的心中",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生歡禧城》"
 },
 {
  "text": "天樞天璇天璣天權天衡開陽瑤光",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生歡禧城》"
 },
 {
  "text": "我也正捶打靈魂的雕像",
  "kind": "lyric",
  "source": "《有一道彩虹》/《雨生歡禧城》"
 },
 {
  "text": "海多深海非深比起相思不算什麼",
  "kind": "lyric",
  "source": "《想你》/《如燕盤旋而來的思念》"
 },
 {
  "text": "想你成一道軌跡彎彎曲曲沒道理",
  "kind": "lyric",
  "source": "《想你》/《如燕盤旋而來的思念》"
 },
 {
  "text": "一筆一筆看似絹細卻相思綿綿無絕期",
  "kind": "lyric",
  "source": "《想你》/《如燕盤旋而來的思念》"
 },
 {
  "text": "想你成一個球體滾來滾去不能停",
  "kind": "lyric",
  "source": "《想你》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我是飄落的楓葉你是仰望的土堆",
  "kind": "lyric",
  "source": "《如燕盤旋而來的思念》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我是月落的聲音你是乍醒的黎明",
  "kind": "lyric",
  "source": "《如燕盤旋而來的思念》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我是荒涼的廢墟你是湮沒的傳奇",
  "kind": "lyric",
  "source": "《如燕盤旋而來的思念》/《如燕盤旋而來的思念》"
 },
 {
  "text": "在幸福的瞬間我感覺偉大卻又卑微",
  "kind": "lyric",
  "source": "《說的再多你也不瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "在最愛的面前我感覺勇猛卻又膽怯",
  "kind": "lyric",
  "source": "《說的再多你也不瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "在感情的棋局裏我們都是過河的兵",
  "kind": "lyric",
  "source": "《說的再多你也不瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "在遊戲的規則裏我與你都不會贏",
  "kind": "lyric",
  "source": "《說的再多你也不瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "若問人生苦求什麼事只需記取橙黃橘綠時",
  "kind": "lyric",
  "source": "《凡》/《如燕盤旋而來的思念》"
 },
 {
  "text": "不如共進一觴悠悠然歌唱人生似幻化",
  "kind": "lyric",
  "source": "《凡》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我的心在竊竊私語承認吧難道是愛情",
  "kind": "lyric",
  "source": "《他（依斯瑪利）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我想我願意對他說出我愛你",
  "kind": "lyric",
  "source": "《他（依斯瑪利）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "他很平凡表面看來一點也沒有魅力",
  "kind": "lyric",
  "source": "《他（依斯瑪利）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "如果你上次離開就決定不要回來",
  "kind": "lyric",
  "source": "《no way out》/《如燕盤旋而來的思念》"
 },
 {
  "text": "愛情的酒汁溢滿從眼角大肆氾濫",
  "kind": "lyric",
  "source": "《no way out》/《如燕盤旋而來的思念》"
 },
 {
  "text": "因爲這是個迷宮你已經陷入其中",
  "kind": "lyric",
  "source": "《no way out》/《如燕盤旋而來的思念》"
 },
 {
  "text": "流什麼淚可以灑進自己的心胸",
  "kind": "lyric",
  "source": "《從你到我》/《如燕盤旋而來的思念》"
 },
 {
  "text": "朝什麼聖可以昇華自己的私情",
  "kind": "lyric",
  "source": "《從你到我》/《如燕盤旋而來的思念》"
 },
 {
  "text": "從你到我有什麼不同",
  "kind": "lyric",
  "source": "《從你到我》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我有一種健忘的毛病它不曾困擾過我",
  "kind": "lyric",
  "source": "《健忘》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我分得出想見不想見的面孔",
  "kind": "lyric",
  "source": "《健忘》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我能夠等待某人幾個小時卻遺忘父母也在對我相思",
  "kind": "lyric",
  "source": "《健忘》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我常渴望巴結那類高尚名流卻遺忘誠心關切我的是誰",
  "kind": "lyric",
  "source": "《健忘》/《如燕盤旋而來的思念》"
 },
 {
  "text": "緣起緣滅讓我的眼眶紅了點",
  "kind": "lyric",
  "source": "《一條大街》/《如燕盤旋而來的思念》"
 },
 {
  "text": "這一條大街怎麼會曲折綿延",
  "kind": "lyric",
  "source": "《一條大街》/《如燕盤旋而來的思念》"
 },
 {
  "text": "似曾相識的一切彷彿陌生的世界",
  "kind": "lyric",
  "source": "《一條大街》/《如燕盤旋而來的思念》"
 },
 {
  "text": "銀河之內我們循着一種軌跡行進",
  "kind": "lyric",
  "source": "《還以爲》/《如燕盤旋而來的思念》"
 },
 {
  "text": "還以爲你聽到我的心如風般的細語",
  "kind": "lyric",
  "source": "《還以爲》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我看見我的眼睛散在你的眼睛裏",
  "kind": "lyric",
  "source": "《還以爲》/《如燕盤旋而來的思念》"
 },
 {
  "text": "偉大是善變的你崇拜着什麼",
  "kind": "lyric",
  "source": "《現代啓示錄（新版）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "美女英雄寂寥身後蓋棺卻辯不休",
  "kind": "lyric",
  "source": "《現代啓示錄（新版）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "文明是耀眼的星星但有誰能夠否認它的無情",
  "kind": "lyric",
  "source": "《現代啓示錄（新版）》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我會瘋狂你的模樣今生最美麗的圖像",
  "kind": "lyric",
  "source": "《我會瘋狂》/《如燕盤旋而來的思念》"
 },
 {
  "text": "所有聲音比不上你縈迴我整個的魂靈",
  "kind": "lyric",
  "source": "《我會瘋狂》/《如燕盤旋而來的思念》"
 },
 {
  "text": "最初的狂喜與最終的寧謐如此和諧",
  "kind": "lyric",
  "source": "《我會瘋狂》/《如燕盤旋而來的思念》"
 },
 {
  "text": "你瑰麗的世界再也不能容許我的存在",
  "kind": "lyric",
  "source": "《我的淚已經流乾》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我的淚已經流乾我的心怏怏收帆",
  "kind": "lyric",
  "source": "《我的淚已經流乾》/《如燕盤旋而來的思念》"
 },
 {
  "text": "任憑它海枯石爛我不再心回意轉",
  "kind": "lyric",
  "source": "《我的淚已經流乾》/《如燕盤旋而來的思念》"
 },
 {
  "text": "淡水河我的心事流向淡水河",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盤旋而來的思念》"
 },
 {
  "text": "行到水窮我纔開始害怕",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盤旋而來的思念》"
 },
 {
  "text": "孑然一身的滋味好不蒼涼",
  "kind": "lyric",
  "source": "《淡水河》/《如燕盤旋而來的思念》"
 },
 {
  "text": "快樂是一刻鐘當你羞怯的面容泛紅",
  "kind": "lyric",
  "source": "《相信》/《如燕盤旋而來的思念》"
 },
 {
  "text": "溫柔是一刻鐘當你淚灑溼我的衣袖",
  "kind": "lyric",
  "source": "《相信》/《如燕盤旋而來的思念》"
 },
 {
  "text": "拉長的影子裏我的心變得不可捉摸",
  "kind": "lyric",
  "source": "《相信》/《如燕盤旋而來的思念》"
 },
 {
  "text": "憂喜是一件兩面的衫你穿着一面藏了一面",
  "kind": "lyric",
  "source": "《憂喜是一件雙面衫》/《如燕盤旋而來的思念》"
 },
 {
  "text": "思念的綿延如海如天也可以輕易被陽光掃下雙眉",
  "kind": "lyric",
  "source": "《憂喜是一件雙面衫》/《如燕盤旋而來的思念》"
 },
 {
  "text": "偶爾會瘋癲偶爾受不住情緒的自虐",
  "kind": "lyric",
  "source": "《憂喜是一件雙面衫》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我依然還在自尋煩惱",
  "kind": "lyric",
  "source": "《even now》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我還把生活過得糜爛糟糕",
  "kind": "lyric",
  "source": "《even now》/《如燕盤旋而來的思念》"
 },
 {
  "text": "還是不曾留意我的心跳一想到你瘋狂了",
  "kind": "lyric",
  "source": "《even now》/《如燕盤旋而來的思念》"
 },
 {
  "text": "青春一轉身就領着驕傲叛逃",
  "kind": "lyric",
  "source": "《我們如此相愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我們如此相愛所以不會分開",
  "kind": "lyric",
  "source": "《我們如此相愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我的愛隨時光凝聚成塊等在時空之外",
  "kind": "lyric",
  "source": "《我們如此相愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "知道我們的距離知道我們的差異",
  "kind": "lyric",
  "source": "《愛我正是時候》/《如燕盤旋而來的思念》"
 },
 {
  "text": "但我捨不得走開你有致命的吸引力",
  "kind": "lyric",
  "source": "《愛我正是時候》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我渴望着朝你靠近渴望着與你同行",
  "kind": "lyric",
  "source": "《愛我正是時候》/《如燕盤旋而來的思念》"
 },
 {
  "text": "讓我起來奮力打開我要知道門外還有愛",
  "kind": "lyric",
  "source": "《門外還有愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我的眼眸鎖定光明的夢一眼望去萬里蔚藍晴空",
  "kind": "lyric",
  "source": "《門外還有愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "花無三日紅人無一時窮",
  "kind": "lyric",
  "source": "《門外還有愛》/《如燕盤旋而來的思念》"
 },
 {
  "text": "人來人往日出日落悲喜憂傷都一樣",
  "kind": "lyric",
  "source": "《遠來的朋友》/《如燕盤旋而來的思念》"
 },
 {
  "text": "總而言之光陰如梭百年終成一頁紙張",
  "kind": "lyric",
  "source": "《遠來的朋友》/《如燕盤旋而來的思念》"
 },
 {
  "text": "遠來的朋友聽我說故舊這一路山光水秀我只是失落",
  "kind": "lyric",
  "source": "《遠來的朋友》/《如燕盤旋而來的思念》"
 },
 {
  "text": "我愛默默在飛霞裏想像歷史的軌轍",
  "kind": "lyric",
  "source": "《遠來的朋友》/《如燕盤旋而來的思念》"
 },
 {
  "text": "挽着我的手街上走",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盤旋而來的思念》"
 },
 {
  "text": "朝着文明朝着人羣朝着青春並肩齊步",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盤旋而來的思念》"
 },
 {
  "text": "就爲那夏日將要奔放的戀曲珍惜每一刻永恆",
  "kind": "lyric",
  "source": "《挽着我的手》/《如燕盤旋而來的思念》"
 },
 {
  "text": "當我的感覺被你瞭解我便擁有了全世界",
  "kind": "lyric",
  "source": "《當我的感覺被你瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "當你爲我開啓全世界我才找到我的殘缺",
  "kind": "lyric",
  "source": "《當我的感覺被你瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "因爲我的快樂是你海天遼闊的笑",
  "kind": "lyric",
  "source": "《當我的感覺被你瞭解》/《如燕盤旋而來的思念》"
 },
 {
  "text": "朋友啊你的激勵的言語牢牢地貼近我心",
  "kind": "lyric",
  "source": "《我學會飛翔》/《青春像把槍》"
 },
 {
  "text": "我學會飛翔飛向最高飛過鷹族的訕笑",
  "kind": "lyric",
  "source": "《我學會飛翔》/《青春像把槍》"
 },
 {
  "text": "我學會去愛愛我的驕傲那是座芬芳環繞的虹橋",
  "kind": "lyric",
  "source": "《我學會飛翔》/《青春像把槍》"
 },
 {
  "text": "少談些兒女私情，少立些燕雀之志",
  "kind": "writing",
  "source": "雨生親筆 · 《好小子立志——我看臺灣生命力》（1990）"
 },
 {
  "text": "窗外的雨若仍涓密下着，請洗盡他們的悲傷",
  "kind": "writing",
  "source": "雨生親筆 · 《浴火見證 爲林靖娟老師而作》（1992-06-09）"
 },
 {
  "text": "愛不在最美的時刻說，那要在什麼時候出口呢",
  "kind": "writing",
  "source": "雨生親筆 · 《“愛”不在最美的時刻說，那要在什…》（1992-06-16）"
 },
 {
  "text": "反反覆覆，走走停停，高高低低，悲悲喜喜",
  "kind": "writing",
  "source": "雨生親筆 · 《嚴肅呆板的我寫不出好情書》（1992-07-26）"
 },
 {
  "text": "未來是什麼？未來是一連串現在的繼續",
  "kind": "writing",
  "source": "雨生親筆 · 《未來是什麼？未來是一連串現在的繼…》（1992-11-09）"
 },
 {
  "text": "夜到最深處，卻是天明的開始",
  "kind": "writing",
  "source": "雨生親筆 · 《未來是什麼？未來是一連串現在的繼…》（1992-11-09）"
 },
 {
  "text": "我要站起來給他們看",
  "kind": "writing",
  "source": "雨生親筆 · 《未來是什麼？未來是一連串現在的繼…》（1992-11-09）"
 },
 {
  "text": "製作得再精緻的皮偶，終究仍是傀儡",
  "kind": "writing",
  "source": "雨生親筆 · 《未來是什麼？未來是一連串現在的繼…》（1992-11-09）"
 },
 {
  "text": "生命的痕跡是要用心去拾取的",
  "kind": "writing",
  "source": "雨生親筆 · 《雜誌從淡水小鎮走出來》（1993）"
 },
 {
  "text": "願大家都能把握心底燃燒的時候",
  "kind": "writing",
  "source": "雨生親筆 · 《雜誌從淡水小鎮走出來》（1993）"
 },
 {
  "text": "你不能遲疑、你不能猶豫，你抓到機會就坦坦蕩蕩向前",
  "kind": "writing",
  "source": "雨生親筆 · 《萬米高空》（1993）"
 },
 {
  "text": "你心底有愛就直直率率表白",
  "kind": "writing",
  "source": "雨生親筆 · 《萬米高空》（1993）"
 },
 {
  "text": "你不能心急你不能焦慮，幸福的花蕊別魯魯莽莽捏碎",
  "kind": "writing",
  "source": "雨生親筆 · 《萬米高空》（1993）"
 },
 {
  "text": "溼漉漉的草香使我們學會真誠的擁抱",
  "kind": "writing",
  "source": "雨生親筆 · 《惠鈴生日星座詩》（1994）"
 },
 {
  "text": "不羨慕、不埋怨，只須要求自己",
  "kind": "writing",
  "source": "雨生親筆 · 《成功嶺受訓家書》（1985-09-07）"
 },
 {
  "text": "要取悅所有的人很難，要貫徹自己的理念很難",
  "kind": "writing",
  "source": "雨生親筆 · 《應是卡拉期間給歌迷繫雨的一封信》（1994-09-19）"
 },
 {
  "text": "希望這是一個坦然的開始，一個混沌的結束",
  "kind": "writing",
  "source": "雨生親筆 · 《應是卡拉期間給歌迷繫雨的一封信》（1994-09-19）"
 },
 {
  "text": "希望自己安靜的時候安靜，表現的時候表現",
  "kind": "writing",
  "source": "雨生親筆 · 《飛碟音樂雜誌元旦寄言》（1995-01-01）"
 },
 {
  "text": "我們都有如脅下生風，飛得又高又遠",
  "kind": "writing",
  "source": "雨生親筆 · 《卡拉OK臺北我宣傳期間寫給歌迷的…》（1995）"
 },
 {
  "text": "藝術倘不能純粹，我不知那是否仍稱爲藝術",
  "kind": "writing",
  "source": "雨生親筆 · 《卡拉OK臺北我宣傳期間寫給歌迷的…》（1995）"
 },
 {
  "text": "何妨學着笑看人生，看看雲、聽聽雨",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "成功，其實是該以平常心看待",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "給自己一個喘息一定會是海闊天空",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "所有外在煩擾也不都只是人生過客，又何必苦苦追求",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "往長遠看，或許得就是失，失亦是得",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "不要給自己太多壓力，只因太大的壓力反而會是阻力",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "讓自己輕輕鬆鬆、簡單快樂的過生活不是很好嗎",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "即使只有一盞小燈火，也要建築心中一片小小樂園",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "擋風遮雨、不忘傳送溫暖",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "讀書是一輩的事",
  "kind": "writing",
  "source": "雨生親筆 · 《熒幕偶像》（1995）"
 },
 {
  "text": "人生海海，能有幾個十年",
  "kind": "writing",
  "source": "雨生親筆 · 《我的酒娜娜》（1996-01-01）"
 },
 {
  "text": "好好生活，好好珍惜自己，好好把握不可多得的生命",
  "kind": "writing",
  "source": "雨生親筆 · 《淡水感言》（1996）"
 },
 {
  "text": "再來吧，重新再來吧",
  "kind": "writing",
  "source": "雨生親筆 · 《淡水感言》（1996）"
 },
 {
  "text": "未來，未來是有無限可能的",
  "kind": "writing",
  "source": "雨生親筆 · 《下半年？帶着愛的花粉種子，隨時準…》（1996）"
 },
 {
  "text": "不要輕易低頭，不要輕言放棄",
  "kind": "writing",
  "source": "雨生親筆 · 《下半年？帶着愛的花粉種子，隨時準…》（1996）"
 },
 {
  "text": "未來是現在的累積",
  "kind": "writing",
  "source": "雨生親筆 · 《下半年？帶着愛的花粉種子，隨時準…》（1996）"
 },
 {
  "text": "奮戰不懈屢敗屢戰的精神是必要的",
  "kind": "writing",
  "source": "雨生親筆 · 《下半年？帶着愛的花粉種子，隨時準…》（1996）"
 },
 {
  "text": "重要的是在過程中，我們才獲得了自信與遭逢橫逆的抗壓力",
  "kind": "writing",
  "source": "雨生親筆 · 《下半年？帶着愛的花粉種子，隨時準…》（1996）"
 },
 {
  "text": "前進的信念應是無入而不自得的境界",
  "kind": "writing",
  "source": "雨生親筆 · 《開學後心境家書》（1986-03-24）"
 },
 {
  "text": "我盡過全力，我絕不愧對永恆",
  "kind": "writing",
  "source": "雨生親筆 · 《爲口是心非寫給豐華老闆彭國華先生…》（1997）"
 },
 {
  "text": "巔峯，正是下墜的開始",
  "kind": "writing",
  "source": "雨生親筆 · 《爲口是心非寫給豐華老闆彭國華先生…》（1997）"
 },
 {
  "text": "忘記過去，放眼將來",
  "kind": "writing",
  "source": "雨生親筆 · 《爲口是心非寫給豐華唱片公司工作人…》（1997）"
 },
 {
  "text": "要把每一步，踏得更實在",
  "kind": "writing",
  "source": "雨生親筆 · 《聯合晚報 愛在淡水-口述》（1997-10-22）"
 },
 {
  "text": "人還是應該有夢想",
  "kind": "writing",
  "source": "雨生親筆 · 《聯合晚報 愛在淡水-口述》（1997-10-22）"
 },
 {
  "text": "我的未來，也有夢，不多，但都有實現的可能",
  "kind": "writing",
  "source": "雨生親筆 · 《聯合晚報 愛在淡水-口述》（1997-10-22）"
 },
 {
  "text": "我是樂觀的人，對凡事凡物只有順其自然的態度",
  "kind": "writing",
  "source": "雨生親筆 · 《我是樂觀的人》（1997-10-24）"
 },
 {
  "text": "很多事只想用行動表現，不願再大聲唱高調",
  "kind": "writing",
  "source": "雨生親筆 · 《商量租房子家書》（1986-12-17）"
 },
 {
  "text": "人的成長就是這樣子，你要不停的往前看",
  "kind": "writing",
  "source": "雨生親筆 · 《成長的故事》（1988）"
 },
 {
  "text": "過去的事，不要給你任何陰影或者是任何壓力",
  "kind": "writing",
  "source": "雨生親筆 · 《成長的故事》（1988）"
 },
 {
  "text": "你要怎麼樣走出來，這是一個考驗",
  "kind": "writing",
  "source": "雨生親筆 · 《成長的故事》（1988）"
 },
 {
  "text": "這個世界比我所能想象的，還要大很多很多",
  "kind": "writing",
  "source": "雨生親筆 · 《電臺自述 我的童年往事》（1988）"
 },
 {
  "text": "要活就要活得豐富",
  "kind": "writing",
  "source": "雨生親筆 · 《電臺自述 我的童年往事》（1988）"
 },
 {
  "text": "唱歌是一種情感的釋放，創作則是理想的實現",
  "kind": "writing",
  "source": "雨生親筆 · 《電臺自述 我的童年往事》（1988）"
 },
 {
  "text": "在生活中學習，便在生活中成長",
  "kind": "writing",
  "source": "雨生親筆 · 《民生報星言星語-永遠是個學生》（1989-03-21）"
 },
 {
  "text": "不管如何，日子不會停下腳步等你",
  "kind": "writing",
  "source": "雨生親筆 · 《9月6日服役期間寫給歌迷的一封信》（1989）"
 },
 {
  "text": "真正的滋味，唯有冷暖自知",
  "kind": "writing",
  "source": "雨生親筆 · 《9月6日服役期間寫給歌迷的一封信》（1989）"
 }
]